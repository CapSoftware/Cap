DESCRIPTION >
	Replace only the bounded mutable traffic-session window for one controller generation.

TOKEN product_events_copy_runner READ

NODE snapshot_product_traffic_daily_hot_v2_node
SQL >
	SELECT *
	FROM product_traffic_daily_bounded_v2

TYPE COPY
TARGET_DATASOURCE product_traffic_daily_hot_v2
COPY_MODE replace
COPY_SCHEDULE @on-demand
