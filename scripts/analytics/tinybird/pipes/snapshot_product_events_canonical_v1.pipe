DESCRIPTION >
	Replace the canonical stream with one stable payload per event ID and quarantine conflicts.

NODE snapshot_product_events_canonical_v1_node
SQL >
	SELECT
		event_id,
		any(payload_hash) AS payload_hash,
		argMax(occurred_at, received_at) AS occurred_at,
		max(received_at) AS received_at,
		argMax(event_name, received_at) AS event_name,
		argMax(schema_version, received_at) AS schema_version,
		argMax(source, received_at) AS source,
		argMax(platform, received_at) AS platform,
		argMax(anonymous_id, received_at) AS anonymous_id,
		argMax(session_id, received_at) AS session_id,
		argMax(user_id, received_at) AS user_id,
		argMax(organization_id, received_at) AS organization_id,
		argMax(app_version, received_at) AS app_version,
		argMax(pathname, received_at) AS pathname,
		argMax(referrer, received_at) AS referrer,
		argMax(country, received_at) AS country,
		argMax(region, received_at) AS region,
		argMax(city, received_at) AS city,
		argMax(hostname, received_at) AS hostname,
		argMax(browser, received_at) AS browser,
		argMax(device, received_at) AS device,
		argMax(os, received_at) AS os,
		argMax(channel, received_at) AS channel,
		argMax(traffic_class, received_at) AS traffic_class,
		argMax(synthetic_run_id, received_at) AS synthetic_run_id,
		argMax(properties, received_at) AS properties
	FROM product_events_v1
	GROUP BY event_id
	HAVING uniqExact(payload_hash) = 1

TYPE COPY
TARGET_DATASOURCE product_events_canonical_v1
COPY_MODE replace
COPY_SCHEDULE */5 * * * *
