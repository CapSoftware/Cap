DESCRIPTION >
	Eight-hundred-day signup cohorts and the defensible activation milestone of creating a first share link within seven UTC days.

TOKEN product_events_copy_runner APPEND

SCHEMA >
	calculated_at DateTime64(3),
	copy_run_id String,
	synthetic_run_id String,
	cohort_date Date,
	signups AggregateFunction(uniqExact, String),
	activated_creators AggregateFunction(uniqExact, String),
	time_to_activation_ms UInt64

ENGINE AggregatingMergeTree
ENGINE_PARTITION_KEY toYYYYMM(cohort_date)
ENGINE_SORTING_KEY (copy_run_id, synthetic_run_id, cohort_date)
ENGINE_TTL cohort_date + INTERVAL 800 DAY
ENGINE_SETTINGS index_granularity = 256
