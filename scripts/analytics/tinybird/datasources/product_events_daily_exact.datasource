DESCRIPTION >
	Five-year exact daily product decision metrics rebuilt from canonical event IDs.

SCHEMA >
	calculated_at DateTime64(3),
	date Date,
	event_name LowCardinality(String),
	source LowCardinality(String),
	platform LowCardinality(String),
	app_version LowCardinality(String),
	hostname LowCardinality(String),
	country LowCardinality(String),
	device LowCardinality(String),
	browser LowCardinality(String),
	os LowCardinality(String),
	channel LowCardinality(String),
	traffic_class LowCardinality(String),
	synthetic_run_id String,
	plan_id LowCardinality(String),
	payment_status LowCardinality(String),
	subscription_status LowCardinality(String),
	currency LowCardinality(String),
	billing_interval LowCardinality(String),
	events UInt64,
	actors AggregateFunction(uniqExact, String),
	users AggregateFunction(uniqExact, String),
	organizations AggregateFunction(uniqExact, String),
	revenue_minor Int64

ENGINE AggregatingMergeTree
ENGINE_PARTITION_KEY toYYYYMM(date)
ENGINE_SORTING_KEY (date, event_name, source, platform, app_version, hostname, country, device, browser, os, channel, traffic_class, synthetic_run_id, plan_id, payment_status, subscription_status, currency, billing_interval)
ENGINE_TTL date + INTERVAL 5 YEAR
ENGINE_SETTINGS index_granularity = 256
