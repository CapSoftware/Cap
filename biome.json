{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**",
			"!**/tauri.ts",
			"!**/queries.ts",
			"!apps/desktop/src/utils/tauri.ts",
			"!apps/desktop/src/global.d.ts",
			"!apps/web/public/gif.worker.js",
			"!packages/ui-solid/src/auto-imports.d.ts",
			"!capcodec/**/*.tov",
			"!capcodec/**/*.py",
			"!capcodec/**/*.md",
			"!capcodec/**/*.sh",
			"!capcodec/**/*.jsonl",
			"!capcodec/**/*.pyc",
			"!capcodec/capcodec.bundle"
		],
		"ignoreUnknown": false
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"suspicious": {
				"noShadowRestrictedNames": "off"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"overrides": [
		{
			"includes": ["apps/desktop/**/*"],
			"linter": {
				"rules": { "a11y": "off" }
			}
		},
		{
			"includes": ["**/*.css"],
			"linter": {
				"rules": {
					"suspicious": {
						"noUnknownAtRules": "off"
					},
					"correctness": {
						"noUnknownTypeSelector": "off"
					},
					"style": {
						"noDescendingSpecificity": "off"
					}
				}
			}
		}
	]
}
