  spinMs = SPIN_MAX_MS
  spinBudget: Float64Array = new Float64Array(0)
  weighted = true
  wpOn = false
  wpChromaOn = false
  wpY: int[] = [64, 0]
  wpU: int[] = [64, 0]
  wpV: int[] = [64, 0]
  wref: Uint8Array = new Uint8Array(0)
