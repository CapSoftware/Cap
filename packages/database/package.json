{
	"name": "@cap/database",
	"private": true,
	"type": "module",
	"types": "./index.ts",
	"main": "index.js",
	"scripts": {
		"db:generate": "drizzle-kit generate --config=drizzle.config.ts",
		"db:push": "drizzle-kit push --config=drizzle.config.ts",
		"db:check": "drizzle-kit check:mysql --config=drizzle.config.ts",
		"db:up": "drizzle-kit up:mysql --config=drizzle.config.ts",
		"db:drop": "drizzle-kit drop --config=drizzle.config.ts",
		"db:studio": "drizzle-kit studio --config=drizzle.config.ts",
		"db:check-integrity": "node scripts/check-migration-integrity.js",
		"drizzle-kit": "bun run dotenv -e ../../.env drizzle-kit --config=drizzle.config.ts",
		"build": "tsdown"
	},
	"dependencies": {
		"@cap/env": "workspace:*",
		"@cap/web-domain": "workspace:*",
		"@effect/sql-mysql2": "^4.0.4",
		"@kubiks/otel-drizzle": "^2.1.0",
		"@mattrax/mysql-planetscale": "^0.0.3",
		"@paralleldrive/cuid2": "^3.3.0",
		"@planetscale/database": "^2.0.0",
		"@react-email/components": "^1.0.12",
		"@react-email/render": "2.1.0",
		"@react-email/tailwind": "^2.0.7",
		"@workos-inc/node": "^11.0.0",
		"drizzle-orm": "0.45.4",
		"dub": "^0.74.0",
		"effect": "^4.0.4",
		"mysql2": "^3.24.6",
		"nanoid": "^6.0.2",
		"next": "16.4.0",
		"next-auth": "^4.24.15",
		"react-email": "^6.11.1",
		"resend": "6.32.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@cap/ui": "workspace:*",
		"@cap/utils": "workspace:*",
		"@types/node": "^26.6.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "19.3.0",
		"dotenv-cli": "^11.0.0",
		"drizzle-kit": "0.31.11",
		"nodemailer": "^10.1.1",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-router-dom": "^7.18.4",
		"tsconfig": "workspace:*",
		"typescript": "^7.0.2"
	},
	"engines": {
		"node": ">=20"
	},
	"exports": {
		".": "./index.ts",
		"./auth/auth-options": "./auth/auth-options.ts",
		"./auth/domain-utils": "./auth/domain-utils.ts",
		"./auth/session": "./auth/session.ts",
		"./auth/sso": "./auth/sso.ts",
		"./auth/sso-state": "./auth/sso-state.ts",
		"./schema": "./schema.ts",
		"./video-sharing-default": "./video-sharing-default.ts",
		"./loops/*": "./loops/*.ts",
		"./crypto": "./crypto.ts",
		"./helpers": "./helpers.ts",
		"./emails/config": "./emails/config.ts",
		"./emails/*": "./emails/*.tsx",
		"./types": "./types/index.ts",
		"./migrate": "./migrate.ts"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.js",
			"./auth/auth-options": "./dist/auth/auth-options.js",
			"./auth/domain-utils": "./dist/auth/domain-utils.js",
			"./auth/session": "./dist/auth/session.js",
			"./schema": "./dist/schema.js",
			"./crypto": "./dist/crypto.js",
			"./helpers": "./dist/helpers.js"
		}
	}
}
