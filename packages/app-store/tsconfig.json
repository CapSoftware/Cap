{
	"extends": "../config/base.tsconfig.json",
	"exclude": ["node_modules", "dist"],
	"include": ["src/**/*.ts", "test/**/*.ts"],
	"compilerOptions": {
		"moduleResolution": "bundler",
		"composite": true,
		"outDir": "dist",
		"noEmit": false,
		"emitDeclarationOnly": true,
		"types": ["node"]
	}
}
