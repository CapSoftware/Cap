+/// Whether `device` draws on the CPU: an adapter flagged as software, or Windows'
+/// Basic Render Driver (WARP), which DXGI does not always flag.
+fn draws_on_cpu(device: &ID3D11Device) -> bool {
+    let desc = device
+        .cast::<IDXGIDevice>()
+        .and_then(|dxgi| unsafe { dxgi.GetAdapter() })
+        .and_then(|adapter| adapter.cast::<IDXGIAdapter1>())
+        .and_then(|adapter| unsafe { adapter.GetDesc1() });
+    let on_cpu = desc.is_ok_and(|desc| {
+        desc.Flags & DXGI_ADAPTER_FLAG_SOFTWARE.0 as u32 != 0
+            || (desc.VendorId == 0x1414 && desc.DeviceId == 0x8C)
+    });
+    log::info!(
+        "atlas writes {}",
+        if on_cpu {
+            "staged (CPU renderer)"
+        } else {
+            "direct"
+        }
+    );
+    on_cpu
+}
+
+/// Writes `bytes` (rows `row_pitch` bytes apart) into `target` at `origin` with a queued copy
+/// from a texture made with them. WARP runs `UpdateSubresource` only after every queued frame
+/// that reads `target` has been rasterized on the CPU, which held a frame for hundreds of
+/// milliseconds each time a note brought new glyphs; a queued copy does not wait. False when
+/// the texture could not be made (the caller then writes directly).
+fn write_via_copy(
+    device: &ID3D11Device,
+    device_context: &ID3D11DeviceContext,
+    target: &ID3D11Texture2D,
+    origin: Point<DevicePixels>,
+    size: Size<DevicePixels>,
+    bytes: &[u8],
+    row_pitch: u32,
+) -> bool {
+    if size.width.0 <= 0 || size.height.0 <= 0 {
+        return false;
+    }
+    let mut desc = D3D11_TEXTURE2D_DESC::default();
+    unsafe { target.GetDesc(&mut desc) };
+    desc.Width = size.width.0 as u32;
+    desc.Height = size.height.0 as u32;
+    desc.MipLevels = 1;
+    desc.ArraySize = 1;
+    desc.SampleDesc = DXGI_SAMPLE_DESC {
+        Count: 1,
+        Quality: 0,
+    };
+    desc.Usage = D3D11_USAGE_DEFAULT;
+    desc.BindFlags = 0;
+    desc.CPUAccessFlags = 0;
+    desc.MiscFlags = 0;
+    let data = D3D11_SUBRESOURCE_DATA {
+        pSysMem: bytes.as_ptr() as _,
+        SysMemPitch: row_pitch,
+        SysMemSlicePitch: 0,
+    };
+    let mut source = None;
+    if unsafe { device.CreateTexture2D(&desc, Some(&data), Some(&mut source)) }.is_err() {
+        return false;
+    }
+    let Some(source) = source else {
+        return false;
+    };
+    unsafe {
+        device_context.CopySubresourceRegion(
+            target,
+            0,
+            origin.x.0 as u32,
+            origin.y.0 as u32,
+            0,
+            &source,
+            0,
+            None,
+        );
+    }
+    true
+}
