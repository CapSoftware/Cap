{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"resolveJsonModule": true,
		"lib": ["ES2022"],
		"strict": true,
		"noEmit": true,
		"types": ["./worker-configuration.d.ts"],
		"skipLibCheck": true
	},
	"include": ["src/**/*.ts", "worker-configuration.d.ts"]
}
