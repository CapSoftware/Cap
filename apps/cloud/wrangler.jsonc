{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "capux",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-25",
	"workers_dev": true,
	"preview_urls": false,
	"assets": {
		"directory": "public",
		"binding": "ASSETS",
		"run_worker_first": true,
		"html_handling": "none"
	},
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "capux-media"
		}
	],
	"ratelimits": [
		{
			"name": "FEEDBACK_LIMIT",
			"namespace_id": "4801",
			"simple": {
				"limit": 10,
				"period": 60
			}
		},
		{
			"name": "FEEDBACK_SITE_LIMIT",
			"namespace_id": "4802",
			"simple": {
				"limit": 120,
				"period": 60
			}
		}
	],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 0.1,
		"traces": {
			"enabled": true,
			"head_sampling_rate": 0.1
		}
	}
}
