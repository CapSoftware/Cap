{
	"name": "@cap/desktop",
	"version": "0.5.9",
	"description": "Cap screen recorder and editor",
	"author": "Cap Software",
	"type": "module",
	"main": "electron/main.cjs",
	"scripts": {
		"dev": "pnpm -w cap-setup && pnpm build:sidecar && pnpm build:backend && pnpm build:electron-main && dotenv -e ../../.env -- pnpm run preparescript && concurrently -k -s first \"pnpm localdev\" \"wait-on http://localhost:3002 && electron .\"",
		"build:backend": "cargo build --manifest-path ../../Cargo.toml --package cap-desktop",
		"build:backend:release": "cargo build --manifest-path ../../Cargo.toml --package cap-desktop --release",
		"build:electron": "pnpm build:sidecar && dotenv -e ../../.env -- pnpm run preparescript && pnpm build && pnpm build:electron-main && electron-builder",
		"build:electron-main": "node scripts/build-electron.mjs",
		"build:sidecar": "node ../../scripts/build-desktop-binaries.mjs",
		"preparescript": "node scripts/prepare.js",
		"localdev": "dotenv -e ../../.env -- vinxi dev --port 3002",
		"build": "vinxi build",
		"test:display-transport": "node scripts/desktop-display-transport-benchmark.js",
		"test:memory": "node scripts/desktop-memory-soak.js",
		"test:memory:unit": "vitest run scripts/desktop-memory-soak.test.js"
	},
	"dependencies": {
		"electron-updater": "6.8.9"
	},
	"devDependencies": {
		"@aerofoil/rive-solid-canvas": "^2.1.4",
		"@cap/database": "workspace:*",
		"@cap/ui-solid": "workspace:*",
		"@cap/utils": "workspace:*",
		"@cap/web-api-contract": "workspace:*",
		"@corvu/tooltip": "^0.2.1",
		"@kobalte/core": "^0.13.11",
		"@openpanel/web": "^1.4.1",
		"@radix-ui/colors": "^3.0.0",
		"@rive-app/canvas": "^2.32.2",
		"@solid-primitives/bounds": "^0.0.122",
		"@solid-primitives/broadcast-channel": "^0.1.1",
		"@solid-primitives/context": "^0.2.3",
		"@solid-primitives/date": "^2.0.23",
		"@solid-primitives/deep": "^0.2.9",
		"@solid-primitives/event-bus": "^1.1.1",
		"@solid-primitives/event-listener": "^2.3.3",
		"@solid-primitives/history": "^0.1.5",
		"@solid-primitives/memo": "^1.4.2",
		"@solid-primitives/mouse": "^2.1.2",
		"@solid-primitives/refs": "^1.0.8",
		"@solid-primitives/resize-observer": "^2.0.26",
		"@solid-primitives/scheduled": "^1.4.3",
		"@solid-primitives/storage": "^4.0.0",
		"@solid-primitives/timer": "^1.3.9",
		"@solid-primitives/websocket": "^1.2.2",
		"@solidjs/router": "^0.14.2",
		"@solidjs/start": "^1.1.3",
		"@tanstack/solid-query": "^5.51.21",
		"@ts-rest/core": "^3.52.1",
		"@types/react-tooltip": "^4.2.4",
		"cva": "npm:class-variance-authority@^0.7.0",
		"effect": "^3.18.4",
		"lz4-wasm": "^0.9.2",
		"mp4box": "^0.5.2",
		"solid-js": "^1.9.3",
		"solid-markdown": "^2.0.13",
		"solid-presence": "^0.1.8",
		"solid-toast": "^0.5.0",
		"solid-transition-group": "^0.2.3",
		"unplugin-auto-import": "^0.18.2",
		"unplugin-icons": "^0.19.2",
		"uuid": "^9.0.1",
		"vinxi": "^0.5.6",
		"webcodecs": "^0.1.0",
		"zod": "^3.25.76",
		"@fontsource/geist-sans": "^5.0.3",
		"@iconify/json": "^2.2.239",
		"@solid-devtools/overlay": "^0.33.5",
		"@tailwindcss/postcss": "^4.2.2",
		"@tailwindcss/typography": "^0.5.9",
		"@total-typescript/ts-reset": "^0.6.1",
		"@types/dom-webcodecs": "^0.1.11",
		"@types/uuid": "^9.0.8",
		"@webgpu/types": "^0.1.44",
		"concurrently": "9.2.1",
		"cross-env": "^7.0.3",
		"electron": "43.4.0",
		"electron-builder": "26.15.3",
		"esbuild": "^0.25.12",
		"solid-devtools": "^0.34.5",
		"tailwind-scrollbar": "^3.1.0",
		"typescript": "^5.8.3",
		"vite": "^6.3.5",
		"vite-plugin-top-level-await": "^1.4.4",
		"vite-plugin-wasm": "^3.4.1",
		"vite-tsconfig-paths": "^5.0.1",
		"vitest": "~2.1.9",
		"wait-on": "9.0.1"
	}
}
