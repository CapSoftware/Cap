		"@solid-primitives/deep": "^0.3.7",
		"@solid-primitives/event-bus": "^1.1.4",
		"@solid-primitives/event-listener": "^2.4.6",
		"@solid-primitives/history": "^0.2.5",
		"@solid-primitives/memo": "^1.5.1",
		"@solid-primitives/mouse": "^2.1.7",
