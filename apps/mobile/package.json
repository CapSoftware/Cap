{
	"name": "@cap/mobile",
	"version": "1.0.0",
	"private": true,
	"main": "expo-router/entry",
	"scripts": {
		"build:development": "bunx eas-cli@21.0.2 build --platform ios --profile development",
		"build:preview": "bunx eas-cli@21.0.2 build --platform ios --profile preview",
		"build:production": "bunx eas-cli@21.0.2 build --platform ios --profile production",
		"dev": "CAP_MOBILE_DISABLE_ASSOCIATED_DOMAINS=1 CAP_MOBILE_BUILD_REACT_NATIVE_FROM_SOURCE=1 sh -c 'node scripts/prepare-ios-development.mjs && if [ \"${CAP_MOBILE_DEVICE:-simulator}\" = \"physical\" ]; then node scripts/run-ios-device.mjs; else node scripts/run-ios-simulator.mjs; fi'",
		"dev:device": "bun run dev:physical",
		"dev:physical": "CAP_MOBILE_DEVICE=physical bun run dev",
		"eas:config": "bunx eas-cli@21.0.2 config --platform ios",
		"start": "expo start --dev-client",
		"submit:production": "bunx eas-cli@21.0.2 submit --platform ios --profile production --latest",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"prebuild:ios": "expo prebuild --platform ios --no-install",
		"ios": "CAP_MOBILE_DISABLE_ASSOCIATED_DOMAINS=1 CAP_MOBILE_BUILD_REACT_NATIVE_FROM_SOURCE=1 sh -c 'node scripts/prepare-ios-development.mjs && expo run:ios'",
		"update:preview": "bunx eas-cli@21.0.2 update --channel preview --environment preview",
		"update:production": "bunx eas-cli@21.0.2 update --channel production --environment production"
	},
	"dependencies": {
		"@cap/web-domain": "workspace:*",
		"@expo/metro-runtime": "~57.0.16",
		"@shopify/flash-list": "2.0.2",
		"effect": "^4.0.4",
		"expo": "~57.0.28",
		"expo-apple-authentication": "~57.0.2",
		"expo-build-properties": "~57.0.22",
		"expo-camera": "~57.0.6",
		"expo-clipboard": "~57.0.2",
		"expo-constants": "~57.0.21",
		"expo-dev-client": "~57.0.20",
		"expo-device": "~57.0.2",
		"expo-document-picker": "~57.0.3",
		"expo-file-system": "~57.0.7",
		"expo-font": "~57.0.4",
		"expo-glass-effect": "~57.0.4",
		"expo-haptics": "~57.0.3",
		"expo-image": "~57.0.5",
		"expo-image-picker": "~57.0.20",
		"expo-linking": "~57.0.12",
		"expo-media-library": "~57.0.5",
		"expo-router": "~57.0.26",
		"expo-secure-store": "~57.0.4",
		"expo-sharing": "~57.0.23",
		"expo-splash-screen": "~57.0.10",
		"expo-symbols": "~57.0.3",
		"expo-updates": "~57.0.26",
		"expo-video": "~57.0.5",
		"expo-web-browser": "~57.0.3",
		"react": "19.2.3",
		"react-dom": "19.2.3",
		"react-native": "0.86.3",
		"react-native-gesture-handler": "~2.32.0",
		"react-native-reanimated": "4.5.1",
		"react-native-safe-area-context": "~5.7.0",
		"react-native-screens": "~4.26.0",
		"react-native-svg": "15.15.4",
		"react-native-web": "~0.21.4",
		"react-native-worklets": "0.10.1"
	},
	"devDependencies": {
		"@testing-library/react-native": "^14.1.0",
		"@types/node": "26.6.5",
		"@types/react": "~19.2.4",
		"@types/react-test-renderer": "^19.3.0",
		"babel-preset-expo": "~57.0.15",
		"react-test-renderer": "19.2.3",
		"typescript": "~6.0.3",
		"vitest": "^5.0.4"
	}
}
