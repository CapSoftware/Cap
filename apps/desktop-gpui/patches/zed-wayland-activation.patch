     fn activate(&self);
+    /// Activates the window with a token the compositor issued to another
+    /// client, such as the `XDG_ACTIVATION_TOKEN` a launcher gave a second
+    /// instance of the app. Focus stealing prevention honours it where a
+    /// token the window requests for itself is refused.
+    fn activate_with_token(&self, token: String) {
+        let _ = token;
+        self.activate();
+    }
     /// Requests that the operating system draw attention to this window.
     fn request_attention(&self) {}
     fn is_active(&self) -> bool;
