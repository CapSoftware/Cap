 }
 
+// Straight alpha, composited like `polychrome_sprite_fragment` composites
+// the same pixels from the atlas.
+fragment float4 surface_bgra_straight_alpha_fragment(
+    SurfaceFragmentInput input [[stage_in]],
+    constant SurfaceBounds *surfaces [[buffer(SurfaceInputIndex_Surfaces)]],
+    texture2d<float> color_texture [[texture(SurfaceInputIndex_YTexture)]]) {
+  constexpr sampler texture_sampler(mag_filter::linear, min_filter::linear);
+  SurfaceBounds surface = surfaces[0];
+  float4 color = color_texture.sample(texture_sampler, input.texture_position);
+  float distance =
+      quad_sdf(input.position.xy, surface.bounds, surface.corner_radii);
+  color.a *= surface.opacity * saturate(0.5 - distance);
+  return color;
+}
+
 float4 hsla_to_rgba(Hsla hsla) {
   float h = hsla.h * 6.0; // Now, it's an angle but scaled in [0, 6) range
   float s = hsla.s;
