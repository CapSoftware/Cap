+
+    const WIDTH: usize = 1280;
+    const HEIGHT: usize = 720;
+
+    /// Straight-alpha BGRA shaped like a camera cutout (opaque person, soft
+    /// edge, transparent background) with per-texel noise, so any texel or
+    /// filter-weight mismatch between the two paths changes the output.
+    fn cutout_pixels() -> Vec<u8> {
+        let mut state = 0x2545_f491_u32;
+        let mut pixels = Vec::with_capacity(WIDTH * HEIGHT * 4);
+        for y in 0..HEIGHT {
+            for x in 0..WIDTH {
+                state ^= state << 13;
+                state ^= state >> 17;
+                state ^= state << 5;
+                let dx = (x as f32 - WIDTH as f32 / 2.) / (WIDTH as f32 * 0.25);
+                let dy = (y as f32 - HEIGHT as f32) / (HEIGHT as f32 * 0.8);
+                let alpha = ((1.1 - (dx * dx + dy * dy).sqrt()) * 6.).clamp(0., 1.);
+                let noise = state.to_le_bytes();
+                let alpha = if noise[3] < 16 {
+                    noise[3]
+                } else {
+                    (alpha * 255.).round() as u8
+                };
+                pixels.extend_from_slice(&[noise[0], noise[1], noise[2], alpha]);
+            }
+        }
+        pixels
+    }
+
+    fn surface(pixels: &[u8]) -> CVPixelBuffer {
+        let io_surface_properties = CFDictionary::<CFString, CFType>::from_CFType_pairs(&[]);
+        let options = CFDictionary::from_CFType_pairs(&[
+            (
+                CFString::from(CVPixelBufferKeys::IOSurfaceProperties),
+                io_surface_properties.as_CFType(),
+            ),
+            (
+                CFString::from(CVPixelBufferKeys::MetalCompatibility),
+                CFBoolean::true_value().as_CFType(),
+            ),
+        ]);
+        let buffer =
+            CVPixelBuffer::new(kCVPixelFormatType_32BGRA, WIDTH, HEIGHT, Some(&options)).unwrap();
+        assert_eq!(buffer.lock_base_address(0), 0);
+        let stride = buffer.get_bytes_per_row();
+        let base = unsafe { buffer.get_base_address() }.cast::<u8>();
+        for (row, source) in pixels.chunks_exact(WIDTH * 4).enumerate() {
+            unsafe {
+                ptr::copy_nonoverlapping(source.as_ptr(), base.add(row * stride), source.len())
+            };
+        }
+        assert_eq!(buffer.unlock_base_address(0), 0);
+        buffer
+    }
+
+    /// `Window::paint_image_fitted`'s crop of an atlas tile.
+    fn crop_tile(
+        mut tile: AtlasTile,
+        visible: Bounds<Pixels>,
+        fitted: Bounds<Pixels>,
+    ) -> AtlasTile {
+        if visible == fitted {
+            return tile;
+        }
+        let fw = f32::from(fitted.size.width).max(1.0);
+        let fh = f32::from(fitted.size.height).max(1.0);
+        let fx = (f32::from(visible.origin.x) - f32::from(fitted.origin.x)) / fw;
+        let fy = (f32::from(visible.origin.y) - f32::from(fitted.origin.y)) / fh;
+        let fsw = f32::from(visible.size.width) / fw;
+        let fsh = f32::from(visible.size.height) / fh;
+        let tw = tile.bounds.size.width.0 as f32;
+        let th = tile.bounds.size.height.0 as f32;
+        tile.bounds.origin.x = DevicePixels(tile.bounds.origin.x.0 + (fx * tw).round() as i32);
+        tile.bounds.origin.y = DevicePixels(tile.bounds.origin.y.0 + (fy * th).round() as i32);
+        tile.bounds.size.width = DevicePixels((fsw * tw).round().max(1.0) as i32);
+        tile.bounds.size.height = DevicePixels((fsh * th).round().max(1.0) as i32);
+        tile
+    }
+
+    /// Name, scale factor, logical bubble size, corner radius and opacity:
+    /// cutout bubbles at the smallest, default and largest sizes in both
+    /// shapes, the reveal fade, and a rounded crop.
+    const CASES: &[(&str, f32, (f32, f32), f32, f32)] = &[
+        ("full 230 @2x", 2., (408.88889, 230.), 0., 1.),
+        ("full 150 @1x", 1., (266.66666, 150.), 0., 1.),
+        ("square 230 @2x", 2., (230., 230.), 0., 1.),
+        ("square 400 @1.5x", 1.5, (400., 400.), 0., 1.),
+        ("full 230 @2x reveal", 2., (408.88889, 230.), 0., 0.37),
+        ("full 600 @2x", 2., (1066.6666, 600.), 0., 1.),
+        ("square 600 @2x", 2., (600., 600.), 0., 1.),
+        ("rounded 300 @2x", 2., (300., 300.), 150., 0.8),
+    ];
+
+    fn device_bounds(bounds: Bounds<Pixels>, scale: f32) -> Bounds<ScaledPixels> {
+        let left = (f32::from(bounds.origin.x) * scale).round();
+        let top = (f32::from(bounds.origin.y) * scale).round();
+        let right = (f32::from(bounds.origin.x + bounds.size.width) * scale).round();
+        let bottom = (f32::from(bounds.origin.y + bounds.size.height) * scale).round();
+        Bounds::from_corners(
+            point(ScaledPixels(left), ScaledPixels(top)),
+            point(ScaledPixels(right), ScaledPixels(bottom)),
+        )
+    }
+
+    fn render(
+        renderer: &mut MetalRenderer,
+        viewport: Size<DevicePixels>,
+        primitive: impl FnOnce(&mut Scene, ContentMask<ScaledPixels>),
