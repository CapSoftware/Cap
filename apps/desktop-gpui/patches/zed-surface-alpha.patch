+impl PaintSurface {
+    /// The source UVs that crop a `texture_size` surface to the `visible`
+    /// part of its `fitted` box, snapped to whole texels the same way
+    /// `Window::paint_image_fitted` crops an atlas tile.
+    pub fn texel_source_uv(
+        visible: Bounds<Pixels>,
+        fitted: Bounds<Pixels>,
+        texture_size: Size<DevicePixels>,
+    ) -> Bounds<f32> {
+        if visible == fitted {
+            return Bounds {
+                origin: point(0., 0.),
+                size: size(1., 1.),
+            };
+        }
+        let fw = f32::from(fitted.size.width).max(1.0);
+        let fh = f32::from(fitted.size.height).max(1.0);
+        let fx = (f32::from(visible.origin.x) - f32::from(fitted.origin.x)) / fw;
+        let fy = (f32::from(visible.origin.y) - f32::from(fitted.origin.y)) / fh;
+        let fsw = f32::from(visible.size.width) / fw;
+        let fsh = f32::from(visible.size.height) / fh;
+        let tw = texture_size.width.0 as f32;
+        let th = texture_size.height.0 as f32;
+        Bounds {
+            origin: point(
+                (fx * tw).round() as i32 as f32 / tw,
+                (fy * th).round() as i32 as f32 / th,
+            ),
+            size: size(
+                (fsw * tw).round().max(1.0) as i32 as f32 / tw,
+                (fsh * th).round().max(1.0) as i32 as f32 / th,
+            ),
+        }
+    }
