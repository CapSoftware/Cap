+#[cfg(test)]
+mod surface_alpha_tests {
+    use super::*;
+    use core_foundation::{
+        base::CFType, boolean::CFBoolean, dictionary::CFDictionary, string::CFString,
+    };
+    use core_video::pixel_buffer::{CVPixelBuffer, CVPixelBufferKeys};
+    use gpui::{
