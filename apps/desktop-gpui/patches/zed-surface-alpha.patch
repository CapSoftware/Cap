+    /// The camera cutout used to be copied into a `RenderImage` and painted
+    /// from the sprite atlas every frame. Painting the IOSurface with
+    /// `straight_alpha` must put the same bytes on screen.
+    #[test]
+    fn straight_alpha_surface_matches_atlas_image() {
+        if metal::Device::system_default().is_none() {
+            return;
+        }
+        let mut renderer =
+            MetalRenderer::new_headless(Arc::new(Mutex::new(InstanceBufferPool::default())))
+                .expect("failed to initialize headless renderer");
+        renderer.update_transparency(true);
+        let pixels = cutout_pixels();
+        let buffer = surface(&pixels);
+        let texture_size = size(DevicePixels(WIDTH as i32), DevicePixels(HEIGHT as i32));
+        let atlas = renderer.sprite_atlas().clone();
+
+        for (index, &(name, scale, (width, height), radius, opacity)) in CASES.iter().enumerate() {
+            let element = Bounds {
+                origin: point(px(0.), px(0.)),
+                size: size(px(width), px(height)),
+            };
+            let fitted = ObjectFit::Cover.get_bounds(element, texture_size);
+            let visible = element.intersect(&fitted);
+            let bounds = device_bounds(visible, scale);
+            let corner_radii = Corners::all(ScaledPixels(radius * scale));
+            let viewport = size(
+                DevicePixels(bounds.size.width.0 as i32 + 8),
+                DevicePixels(bounds.size.height.0 as i32 + 8),
+            );
+
+            let key = AtlasKey::Image(RenderImageParams {
+                image_id: ImageId(index + 1),
+                frame_index: 0,
+            });
+            let tile = atlas
+                .get_or_insert_with(&key, &mut || {
+                    Ok(Some((texture_size, Cow::Borrowed(pixels.as_slice()))))
+                })
+                .unwrap()
+                .unwrap();
+            let tile = crop_tile(tile, visible, fitted);
+            let image = render(&mut renderer, viewport, |scene, content_mask| {
+                scene.insert_primitive(PolychromeSprite {
+                    order: 0,
+                    pad: 0,
+                    grayscale: false.into(),
+                    opacity,
+                    bounds,
+                    content_mask,
+                    corner_radii,
+                    fade: EdgeFadeParams::default(),
+                    tile,
+                });
+            });
+            atlas.remove(&key);
+
+            let source_uv = PaintSurface::texel_source_uv(visible, fitted, texture_size);
+            let painted = render(&mut renderer, viewport, |scene, content_mask| {
+                scene.insert_primitive(PaintSurface {
+                    order: 0,
+                    bounds,
+                    content_mask,
+                    corner_radii,
+                    source_uv,
+                    straight_alpha: true,
+                    opacity,
+                    image_buffer: buffer.clone(),
+                });
+            });
+
+            // The atlas tile ends at texel row 720 of a 1024-row texture, so
+            // where the draw magnifies, today's path filters the last device
+            // row against texels outside the image; the surface clamps to its
+            // own edge instead. Every other pixel has to match exactly.
+            let texel_height = (source_uv.size.height * HEIGHT as f32).round();
+            let device_height = bounds.size.height.0;
+            let past_last_texel = |row: u32| {
+                (row as f32 + 0.5 - bounds.origin.y.0) / device_height * texel_height
+                    > texel_height - 0.5
+            };
+            let mut differing = 0usize;
+            let mut edge_differing = 0usize;
+            let mut max_difference = 0u8;
+            for (x, y, expected) in image.enumerate_pixels() {
+                let actual = painted.get_pixel(x, y);
+                if expected == actual {
+                    continue;
+                }
+                if past_last_texel(y) {
+                    edge_differing += 1;
+                    continue;
+                }
+                differing += 1;
+                for channel in 0..4 {
+                    max_difference =
+                        max_difference.max(expected[channel].abs_diff(actual[channel]));
+                }
+            }
+            println!(
+                "{name}: {}x{} device px, {differing} differing pixels (max {max_difference}), {edge_differing} on the magnified bottom edge",
+                bounds.size.width.0, bounds.size.height.0,
+            );
+            assert_eq!(
+                differing, 0,
+                "{name}: max channel difference {max_difference}"
+            );
+            let right_half = painted.enumerate_pixels().filter(|(x, y, _)| {
+                *x >= viewport.width.0 as u32 / 2 && *y < bounds.size.height.0 as u32
+            });
+            let alphas = right_half.map(|(_, _, pixel)| pixel[3]).collect::<Vec<_>>();
+            assert!(
+                alphas.contains(&0) && alphas.iter().any(|&alpha| alpha > 0 && alpha < 255),
+                "{name}: surface alpha was not preserved"
+            );
+        }
+    }
+
+    #[test]
+    fn opaque_bgra_surface_still_ignores_alpha() {
+        if metal::Device::system_default().is_none() {
+            return;
+        }
+        let mut renderer =
+            MetalRenderer::new_headless(Arc::new(Mutex::new(InstanceBufferPool::default())))
+                .expect("failed to initialize headless renderer");
+        renderer.update_transparency(true);
+        let buffer = surface(&cutout_pixels());
+        let viewport = size(DevicePixels(320), DevicePixels(180));
+        let image = render(&mut renderer, viewport, |scene, content_mask| {
+            scene.insert_primitive(PaintSurface {
+                order: 0,
+                bounds: content_mask.bounds,
+                content_mask,
+                corner_radii: Corners::default(),
+                source_uv: Bounds {
+                    origin: point(0., 0.),
+                    size: size(1., 1.),
+                },
+                straight_alpha: false,
+                opacity: 1.,
+                image_buffer: buffer,
+            });
+        });
+        assert!(image.pixels().all(|pixel| pixel[3] == 255));
+    }
+}
