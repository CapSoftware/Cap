+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub enum OverscrollBehavior {
+    /// Always allow rubber-band overscroll on scrollable axes.
+    Auto,
+    /// Only allow rubber-band overscroll when the content actually overflows on that axis.
+    #[default]
+    WhenScrollable,
+    /// Browser-style scroll chaining: if a gesture starts while this container can
+    /// scroll in the gesture direction, it owns the gesture and overscrolls once at
+    /// the boundary without scrolling ancestors; if the gesture starts already at the
+    /// boundary (or content does not overflow), it chains directly to the parent.
+    Chain,
+    /// Disable rubber-band overscroll on this container.
+    None,
+}
+
+/// Tuning parameters for GPUI's scroll rubber-banding physics.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct RubberBandConfig {
+    /// Resistance factor applied to overscroll distance (`0.01..=1.0`).
+    pub resistance: f32,
+    /// Critically-damped spring response duration in seconds.
+    pub response: f32,
+    /// Fraction of scroll momentum carried into the spring when hitting an edge.
+    pub momentum_carry: f32,
+    /// Maximum visual overscroll as a fraction of the viewport dimension.
+    pub max_overscroll_ratio: f32,
+    /// Visual offset threshold (in pixels) below which the spring settles to zero.
+    pub settle_epsilon: f32,
+}
+
+impl RubberBandConfig {
+    /// Default rubber-banding physics parameters.
+    pub const DEFAULT: Self = Self {
+        resistance: 0.10,
+        response: if cfg!(target_os = "macos") {
+            0.425
+        } else {
+            0.350
+        },
+        momentum_carry: 0.25,
+        max_overscroll_ratio: 0.50,
+        settle_epsilon: 0.25,
+    };
+}
+
+impl Default for RubberBandConfig {
+    fn default() -> Self {
+        Self::DEFAULT
+    }
+}
+
+static RUBBER_BAND_CONFIG: RwLock<RubberBandConfig> = RwLock::new(RubberBandConfig::DEFAULT);
+
+/// Reads the process-wide rubber-band tuning parameters applied to all scroll views.
+pub fn rubber_band_config() -> RubberBandConfig {
+    *RUBBER_BAND_CONFIG
+        .read()
+        .unwrap_or_else(|poisoned| poisoned.into_inner())
+}
+
+/// Overrides the process-wide rubber-band tuning parameters at runtime for live calibration.
+pub fn set_rubber_band_config(config: RubberBandConfig) {
+    if let Ok(mut guard) = RUBBER_BAND_CONFIG.write() {
+        *guard = config;
+    }
+}
+
+pub(crate) fn rubber_band_offset(
+    raw_overscroll: f32,
+    dimension: f32,
+    config: &RubberBandConfig,
+) -> f32 {
+    if raw_overscroll == 0.0 {
+        return 0.0;
+    }
+    let dim = dimension.max(1.0);
+    let d = raw_overscroll.abs();
+    let c = config.resistance.clamp(0.01, 1.0);
+    let max_overscroll = dim * config.max_overscroll_ratio.clamp(0.05, 0.95);
+    let rubber = (1.0 - 1.0 / (d / dim * c + 1.0)) * dim;
+    raw_overscroll.signum() * rubber.min(max_overscroll)
+}
+
+pub(crate) fn rubber_band_offset_inv(
+    visual_overscroll: f32,
+    dimension: f32,
+    config: &RubberBandConfig,
+) -> f32 {
+    if visual_overscroll == 0.0 {
+        return 0.0;
+    }
+    let dim = dimension.max(1.0);
+    let c = config.resistance.clamp(0.01, 1.0);
+    let v = visual_overscroll.abs().min(dim - 1e-3);
+    visual_overscroll.signum() * (dim * v / (dim - v)) / c
+}
+
+#[derive(Clone, Copy, Debug)]
+pub(crate) struct SpringState {
+    started_at: Instant,
+    lambda: f32,
+    c1: f32,
+    c2: f32,
+    anchor_max_edge: bool,
+}
+
+impl SpringState {
+    fn new(
+        visual_offset: f32,
+        velocity: f32,
+        anchor_max_edge: bool,
+        now: Instant,
+        config: &RubberBandConfig,
+    ) -> Self {
+        let response = config.response.clamp(0.1, 2.0);
+        let lambda = 2.0 * PI / response;
+        Self {
+            started_at: now,
+            lambda,
+            c1: visual_offset,
+            c2: velocity + lambda * visual_offset,
+            anchor_max_edge,
+        }
+    }
+
+    pub(crate) fn offset_at(&self, now: Instant) -> f32 {
+        let t = now.saturating_duration_since(self.started_at).as_secs_f32();
+        (self.c1 + self.c2 * t) * (-self.lambda * t).exp()
+    }
+
+    fn velocity_at(&self, t: f32) -> f32 {
+        (self.c2 - self.lambda * (self.c1 + self.c2 * t)) * (-self.lambda * t).exp()
+    }
+
+    pub(crate) fn evaluate(&self, now: Instant, config: &RubberBandConfig) -> Option<f32> {
+        let t = now.saturating_duration_since(self.started_at).as_secs_f32();
+        let offset = (self.c1 + self.c2 * t) * (-self.lambda * t).exp();
+        let velocity = self.velocity_at(t);
+        if (t > 0.02 && offset.abs() < config.settle_epsilon && velocity.abs() < 1.0) || t > 2.5 {
+            None
+        } else {
+            Some(offset)
+        }
+    }
+}
+
+#[derive(Clone, Copy, Debug, Default)]
+pub(crate) struct RubberBandAxisState {
+    pub(crate) raw_overscroll: f32,
+    pub(crate) spring: Option<SpringState>,
+}
+
+impl RubberBandAxisState {
+    pub(crate) fn catch_spring(
+        &mut self,
+        dim: f32,
+        now: Instant,
+        config: &RubberBandConfig,
+    ) {
+        if let Some(spring) = self.spring.take() {
+            let caught = spring.offset_at(now);
+            self.raw_overscroll = rubber_band_offset_inv(caught, dim, config);
+        }
+    }
+
+    pub(crate) fn start_spring(
+        &mut self,
+        dim: f32,
+        now: Instant,
+        config: &RubberBandConfig,
+    ) -> bool {
+        if self.raw_overscroll != 0.0 {
+            let visual = rubber_band_offset(self.raw_overscroll, dim, config);
+            let anchor_max_edge = self.raw_overscroll > 0.0;
+            self.raw_overscroll = 0.0;
+            self.spring = Some(SpringState::new(visual, 0.0, anchor_max_edge, now, config));
+            true
+        } else {
+            false
+        }
+    }
+
+    pub(crate) fn step_spring(
+        &mut self,
+        now: Instant,
+        max_scroll: f32,
+        config: &RubberBandConfig,
+    ) -> Option<(f32, bool)> {
+        let spring = self.spring?;
+        let base = if spring.anchor_max_edge {
+            0.0
+        } else {
+            -max_scroll.max(0.0)
+        };
+        if let Some(offset) = spring.evaluate(now, config) {
+            Some((base + offset, true))
+        } else {
+            self.spring = None;
+            Some((base, false))
+        }
+    }
+}
+
+#[derive(Clone, Debug, Default)]
+pub(crate) struct RubberBandScrollState {
+    pub(crate) x: RubberBandAxisState,
+    pub(crate) y: RubberBandAxisState,
+    pub(crate) scroll_max: Point<Pixels>,
+    pub(crate) bounds_size: Size<Pixels>,
+    pub(crate) momentum_bounced: bool,
+    pub(crate) last_event_at: Option<Instant>,
+    pub(crate) chain_to_parent_x: Option<bool>,
+    pub(crate) chain_to_parent_y: Option<bool>,
+    pub(crate) scroll_offset_ptr: usize,
+    pub(crate) last_applied_offset: Option<Point<Pixels>>,
+}
+
+impl RubberBandScrollState {
+    pub(crate) fn reset_motion(&mut self) {
+        self.x.raw_overscroll = 0.0;
+        self.x.spring = None;
+        self.y.raw_overscroll = 0.0;
+        self.y.spring = None;
+        self.momentum_bounced = false;
+        self.chain_to_parent_x = None;
+        self.chain_to_parent_y = None;
+    }
+
+    pub(crate) fn start_springs(&mut self, now: Instant, config: &RubberBandConfig) -> bool {
+        let x = self
+            .x
+            .start_spring(self.bounds_size.width.into(), now, config);
+        let y = self
+            .y
+            .start_spring(self.bounds_size.height.into(), now, config);
+        x || y
+    }
+
+    pub(crate) fn is_springing(&self) -> bool {
+        self.x.spring.is_some() || self.y.spring.is_some()
+    }
+}
+
+pub(crate) fn apply_scroll_delta(
+    axis: &mut RubberBandAxisState,
+    offset: &mut f32,
+    max_scroll: f32,
+    delta: f32,
+    dim: f32,
+    dt: f32,
+    is_momentum: bool,
+    allow_overscroll: bool,
+    now: Instant,
+    config: &RubberBandConfig,
+) {
+    if delta == 0.0 {
+        return;
+    }
+    let min = -max_scroll.max(0.0);
+    let max = 0.0;
+
+    if !allow_overscroll {
+        axis.raw_overscroll = 0.0;
+        axis.spring = None;
+        *offset = (*offset + delta).clamp(min, max);
+        return;
+    }
+
+    if axis.raw_overscroll == 0.0 {
+        let next = *offset + delta;
+        if next > max {
+            let excess = next - max;
+            if is_momentum {
+                if config.momentum_carry <= 0.001 {
+                    *offset = max;
+                } else {
+                    let visual = rubber_band_offset(excess * config.momentum_carry, dim, config);
+                    let velocity =
+                        (delta / dt.clamp(0.004, 0.05) * config.momentum_carry).clamp(-2400.0, 2400.0);
+                    axis.spring = Some(SpringState::new(visual, velocity, true, now, config));
+                    *offset = max + visual;
+                }
+            } else {
+                axis.raw_overscroll = excess;
+                *offset = max + rubber_band_offset(axis.raw_overscroll, dim, config);
+            }
+        } else if next < min {
+            let excess = next - min;
+            if is_momentum {
+                if config.momentum_carry <= 0.001 {
+                    *offset = min;
+                } else {
+                    let visual = rubber_band_offset(excess * config.momentum_carry, dim, config);
+                    let velocity =
+                        (delta / dt.clamp(0.004, 0.05) * config.momentum_carry).clamp(-2400.0, 2400.0);
+                    axis.spring = Some(SpringState::new(visual, velocity, false, now, config));
+                    *offset = min + visual;
+                }
+            } else {
+                axis.raw_overscroll = excess;
+                *offset = min + rubber_band_offset(axis.raw_overscroll, dim, config);
+            }
+        } else {
+            *offset = next;
+        }
+    } else {
+        let was_positive = axis.raw_overscroll > 0.0;
+        let next_raw = axis.raw_overscroll + delta;
+        if next_raw == 0.0 || (next_raw > 0.0) != was_positive {
+            axis.raw_overscroll = 0.0;
+            let base = if was_positive { max } else { min };
+            *offset = (base + next_raw).clamp(min, max);
+        } else {
+            axis.raw_overscroll = next_raw;
+            let base = if was_positive { max } else { min };
+            *offset = base + rubber_band_offset(axis.raw_overscroll, dim, config);
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::time::Duration;
+
+    #[test]
+    fn resistance_and_inverse_roundtrip() {
+        let config = RubberBandConfig::DEFAULT;
+        let dim = 600.0;
+        let visual = rubber_band_offset(120.0, dim, &config);
+        let recovered = rubber_band_offset_inv(visual, dim, &config);
+        assert!((recovered - 120.0).abs() < 0.05);
+    }
+
+    #[test]
+    fn analytical_spring_settles_without_overshoot() {
+        let config = RubberBandConfig::DEFAULT;
+        let start = Instant::now();
+        let spring = SpringState::new(80.0, 0.0, true, start, &config);
+
+        let mid = spring
+            .evaluate(start + Duration::from_millis(120), &config)
+            .expect("should still be moving at 120ms");
+        assert!(mid > 0.0 && mid < 80.0);
+
+        let settled = spring.evaluate(start + Duration::from_millis(1200), &config);
+        assert!(settled.is_none());
+    }
+}
