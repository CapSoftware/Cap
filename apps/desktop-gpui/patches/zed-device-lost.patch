+#[cfg(test)]
+mod unmapped_frame_retry_tests {
+    use super::unmapped_frame_needs_retry;
+
+    #[test]
+    fn a_first_frame_lost_to_gpu_recovery_is_drawn_again() {
+        assert!(unmapped_frame_needs_retry(false, false, true));
+    }
+
+    #[test]
+    fn a_mapped_surface_waits_for_its_frame_callback() {
+        assert!(!unmapped_frame_needs_retry(false, true, true));
