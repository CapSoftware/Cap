+/// How long an unmapped window waits before drawing again after a frame that
+/// presented nothing.
+const UNMAPPED_FRAME_RETRY: std::time::Duration = std::time::Duration::from_millis(50);
+
+/// Whether a frame that presented nothing has to be drawn again without a
+/// frame callback. Compositors send those only for a mapped surface, so when
+/// the frame that would have attached the first buffer finds the GPU device
+/// lost, or is spent recovering from that, nothing else asks for the next one
+/// and the window stays invisible for good (GitHub #3946).
+fn unmapped_frame_needs_retry(presented: bool, buffer_attached: bool, render_owed: bool) -> bool {
+    !presented && !buffer_attached && render_owed
+}
