+/// Test hook: `GPUI_INJECT_DEVICE_LOSS` names a file, and creating that file
+/// makes the next frame end the way a frame does when the driver reports the
+/// device lost. Real losses need a driver fault, which tests cannot ask for.
+fn device_loss_injected() -> bool {
+    static TRIGGER: std::sync::LazyLock<Option<std::path::PathBuf>> =
+        std::sync::LazyLock::new(|| std::env::var_os("GPUI_INJECT_DEVICE_LOSS").map(Into::into));
+    TRIGGER
+        .as_ref()
+        .is_some_and(|trigger| std::fs::remove_file(trigger).is_ok())
+}
