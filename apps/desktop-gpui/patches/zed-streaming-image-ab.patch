+            );
+
+            let atlas = MetalAtlas::new(device.clone(), is_apple_gpu);
+            let image = StreamingImage::new(StreamingImageFormat::Bgra8);
+            let mut micros = Vec::with_capacity(ab::FRAMES);
+            let textures = AB_TEXTURES_CREATED.load(Ordering::Relaxed);
