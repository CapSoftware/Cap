+        let mut expected = vec![(platform_window.0 as usize, WM_GPUI_GPU_DEVICE_LOST)];
+        for hwnd in [running, paused] {
+            expected.push((hwnd.0 as usize, WM_GPUI_GPU_DEVICE_LOST));
+            expected.push((hwnd.0 as usize, WM_GPUI_FORCE_UPDATE_WINDOW));
+        }
+        expected.sort();
