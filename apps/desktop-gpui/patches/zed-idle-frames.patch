+#[cfg(test)]
+mod frame_pacer_tests {
+    use super::{FramePacer, FrameRequests, Instant};
+    use std::{cell::RefCell, rc::Rc, time::Duration};
+
+    fn recording_pacer() -> (FramePacer, Rc<RefCell<Vec<FrameRequests>>>, Instant) {
+        let calls = Rc::new(RefCell::new(Vec::new()));
+        let recorded = calls.clone();
+        let pacer = FramePacer::new(Some(Box::new(move |request| {
+            recorded.borrow_mut().push(request)
+        })));
+        let created = pacer.busy_at.get();
+        (pacer, calls, created)
+    }
+
+    fn stopped_pacer() -> (FramePacer, Rc<RefCell<Vec<FrameRequests>>>, Instant) {
+        let (pacer, calls, start) = recording_pacer();
+        pacer.frame_finished(false, false, start + FramePacer::IDLE_DELAY);
+        calls.borrow_mut().clear();
+        (pacer, calls, start + FramePacer::IDLE_DELAY)
+    }
+
+    #[test]
+    fn idle_frames_stop_requests_only_after_the_delay() {
+        let (pacer, calls, start) = recording_pacer();
+        pacer.frame_finished(false, false, start + Duration::from_millis(99));
+        assert!(calls.borrow().is_empty());
+        pacer.frame_finished(false, false, start + FramePacer::IDLE_DELAY);
+        assert_eq!(*calls.borrow(), [FrameRequests::Stop]);
+    }
+
+    #[test]
+    fn busy_or_pending_frames_restart_the_delay() {
+        let (pacer, calls, start) = recording_pacer();
+        pacer.frame_finished(true, false, start + Duration::from_millis(90));
+        pacer.frame_finished(false, true, start + Duration::from_millis(150));
+        pacer.frame_finished(false, false, start + Duration::from_millis(240));
+        assert!(calls.borrow().is_empty());
+        pacer.frame_finished(false, false, start + Duration::from_millis(250));
+        assert_eq!(*calls.borrow(), [FrameRequests::Stop]);
+    }
+
+    #[test]
+    fn a_stopped_window_asks_for_one_frame_per_wake() {
+        let (pacer, calls, now) = stopped_pacer();
+        pacer.wake();
+        pacer.wake();
+        assert_eq!(*calls.borrow(), [FrameRequests::Once]);
+        // The single frame drew everything: requests stay stopped.
+        pacer.frame_finished(true, false, now + Duration::from_millis(50));
+        pacer.wake();
+        assert_eq!(
+            *calls.borrow(),
+            [FrameRequests::Once, FrameRequests::Stop, FrameRequests::Once]
+        );
+    }
+
+    #[test]
+    fn work_left_after_a_single_frame_restarts_requests() {
+        let (pacer, calls, now) = stopped_pacer();
+        pacer.wake();
+        pacer.frame_finished(true, true, now + Duration::from_millis(5));
+        assert_eq!(*calls.borrow(), [FrameRequests::Once, FrameRequests::Start]);
+        // Running again: wakes ask for nothing, and the idle delay applies anew.
+        pacer.wake();
+        pacer.frame_finished(false, false, now + Duration::from_millis(50));
+        assert_eq!(*calls.borrow(), [FrameRequests::Once, FrameRequests::Start]);
+        pacer.frame_finished(false, false, now + Duration::from_millis(105));
+        assert_eq!(
+            *calls.borrow(),
+            [FrameRequests::Once, FrameRequests::Start, FrameRequests::Stop]
+        );
+    }
+
+    #[test]
+    fn a_frame_from_a_link_the_platform_restarted_stops_it_again() {
+        let (pacer, calls, now) = stopped_pacer();
+        pacer.frame_finished(false, false, now + Duration::from_millis(8));
+        assert_eq!(*calls.borrow(), [FrameRequests::Stop]);
+    }
+
+    #[test]
+    fn a_frame_missed_while_stopped_asks_for_another() {
+        let (pacer, calls, _) = stopped_pacer();
+        pacer.missed_frame();
+        assert_eq!(*calls.borrow(), [FrameRequests::Once]);
+        pacer.wake();
+        assert_eq!(*calls.borrow(), [FrameRequests::Once]);
+    }
+
+    #[test]
+    fn a_frame_missed_while_running_asks_for_nothing() {
+        let (pacer, calls, _) = recording_pacer();
+        pacer.missed_frame();
+        assert!(calls.borrow().is_empty());
+    }
+
+    #[test]
+    fn without_a_platform_toggle_nothing_is_tracked() {
+        let pacer = FramePacer::new(None);
+        let start = pacer.busy_at.get();
+        pacer.frame_finished(false, false, start + FramePacer::IDLE_DELAY);
+        assert!(!pacer.paused.get());
+        pacer.wake();
+        assert!(!pacer.once_pending.get());
+    }
+}
