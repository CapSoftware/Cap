+    fn frame_request_toggle(&self) -> Option<Box<dyn Fn(FrameRequests)>> {
+        let window_state = Arc::downgrade(&self.0);
+        Some(Box::new(move |request| {
+            let Some(window_state) = window_state.upgrade() else {
+                return;
+            };
+            let mut lock = window_state.lock();
+            match request {
+                FrameRequests::Stop => {
+                    lock.frame_requests_paused = true;
+                    lock.stop_display_link();
+                }
+                FrameRequests::Start => {
+                    lock.frame_requests_paused = false;
+                    lock.start_display_link();
+                }
+                FrameRequests::Once => {
+                    let visible = unsafe {
+                        lock.native_window
+                            .occlusionState()
+                            .contains(NSWindowOcclusionState::NSWindowOcclusionStateVisible)
+                    };
+                    if !visible {
+                        // A hidden window draws nothing now; let the occlusion
+                        // handler start its link when it is shown, and the
+                        // first frame after that draws what changed meanwhile.
+                        lock.frame_requests_paused = false;
+                        return;
+                    }
+                    // Draw the frame that woke the window now: a restarted
+                    // display link first fires a refresh or two later.
+                    let window_state = Arc::downgrade(&window_state);
+                    lock.foreground_executor
+                        .spawn(async move {
+                            let Some(window_state) = window_state.upgrade() else {
+                                return;
+                            };
+                            let Some(mut callback) =
+                                window_state.lock().request_frame_callback.take()
+                            else {
+                                return;
+                            };
+                            callback(Default::default());
+                            window_state.lock().request_frame_callback = Some(callback);
+                        })
+                        .detach();
+                }
+            }
+        }))
+    }
