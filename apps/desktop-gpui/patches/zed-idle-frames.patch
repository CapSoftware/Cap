+pub(crate) fn set_frame_requests_paused(paused_windows: &PausedWindows, hwnd: HWND, paused: bool) {
+    let mut paused_windows = paused_windows.write();
+    let index = paused_windows
+        .iter()
+        .position(|paused| paused.as_raw() == hwnd);
+    match (index, paused) {
+        (None, true) => paused_windows.push(hwnd.into()),
+        (Some(index), false) => {
+            paused_windows.swap_remove(index);
+        }
+        _ => {}
+    }
 }
 
