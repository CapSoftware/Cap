+        redraw_unpaused_windows(&all_windows.read(), &paused_windows.read());
+        let mut expected = vec![
+            (running.0 as usize, WM_PAINT),
+            (paused.0 as usize, WM_PAINT),
+        ];
+        expected.sort();
+        assert_eq!(drain_messages(), expected);
+
+        for hwnd in [running, paused, platform_window] {
+            unsafe { DestroyWindow(hwnd).log_err() };
+        }
+    }
+}
