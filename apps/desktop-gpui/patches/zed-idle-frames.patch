+/// Applies a platform notification to the window now, or on the next turn of
+/// the run loop when it arrived while the app was already being updated. AppKit
+/// delivers moves, resizes and appearance changes synchronously from inside the
+/// `setFrame:`/`orderFront:` calls an update makes (opening or positioning a
+/// window), and dropping them leaves the window's bounds or appearance stale.
+fn update_window_or_defer(
+    handle: AnyWindowHandle,
+    cx: &mut crate::AsyncApp,
+    update: fn(&mut Window, &mut App),
+) {
+    let Err(error) = handle.update(cx, |_, window, cx| update(window, cx)) else {
+        return;
+    };
+    if !error.is::<std::cell::BorrowMutError>() {
+        Result::<(), _>::Err(error).log_err();
+        return;
+    }
+    let executor = cx.foreground_executor().clone();
+    let mut cx = cx.clone();
+    executor
+        .spawn(async move {
+            handle
+                .update(&mut cx, |_, window, cx| update(window, cx))
+                .log_err();
+        })
+        .detach();
 }
 
