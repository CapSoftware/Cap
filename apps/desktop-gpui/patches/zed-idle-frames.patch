+/// Stops the platform's frame requests once a window has had nothing to draw
+/// for [`FramePacer::IDLE_DELAY`]. While stopped, an invalidation or a
+/// next-frame callback asks for a single frame, and the per-refresh requests
+/// only restart if work is still pending after it (an animation). Without this
+/// an idle window wakes the main thread on every display refresh, and a window
+/// that redraws a few times a second (a level meter, a clock) keeps the
+/// requests running between its redraws.
+pub(crate) struct FramePacer {
+    toggle: Option<Box<dyn Fn(FrameRequests)>>,
+    paused: Cell<bool>,
+    once_pending: Cell<bool>,
+    busy_at: Cell<Instant>,
+}
+
+impl FramePacer {
+    /// Long enough that steady low-rate redraws (30fps video, timers) never
+    /// stop and restart the frame source between frames.
+    const IDLE_DELAY: Duration = Duration::from_millis(100);
+
+    fn new(toggle: Option<Box<dyn Fn(FrameRequests)>>) -> Self {
+        FramePacer {
+            toggle,
+            paused: Cell::new(false),
+            once_pending: Cell::new(false),
+            busy_at: Cell::new(Instant::now()),
+        }
+    }
+
+    fn wake(&self) {
+        if let Some(toggle) = &self.toggle
+            && self.paused.get()
+            && !self.once_pending.replace(true)
+        {
+            toggle(FrameRequests::Once);
+        }
+    }
+
+    /// A frame request that arrived while the app was mid-update and could not
+    /// run. While requests are stopped nothing else would draw what woke the
+    /// window, so ask for another single frame.
+    fn missed_frame(&self) {
+        if let Some(toggle) = &self.toggle
+            && self.paused.get()
+        {
+            self.once_pending.set(true);
+            toggle(FrameRequests::Once);
+        }
+    }
+
+    /// `busy`: the frame did work. `pending`: work is left for the next frame.
+    fn frame_finished(&self, busy: bool, pending: bool, now: Instant) {
+        let Some(toggle) = &self.toggle else {
+            return;
+        };
+        if self.paused.get() {
+            self.once_pending.set(false);
+            if pending {
+                self.paused.set(false);
+                self.busy_at.set(now);
+                toggle(FrameRequests::Start);
+            } else {
+                // Also stops a link the platform restarted on its own (a window
+                // shown again while it had nothing to draw).
+                toggle(FrameRequests::Stop);
+            }
+        } else if busy || pending {
+            self.busy_at.set(now);
+        } else if now.duration_since(self.busy_at.get()) >= Self::IDLE_DELAY {
+            self.paused.set(true);
+            toggle(FrameRequests::Stop);
+        }
+    }
+}
+
+/// Applies a platform notification to the window now, or on the next turn of
+/// the run loop when it arrived while the app was already being updated. AppKit
+/// delivers moves, resizes and appearance changes synchronously from inside the
+/// `setFrame:`/`orderFront:` calls an update makes (opening or positioning a
+/// window), and dropping them leaves the window's bounds or appearance stale.
+fn update_window_or_defer(
+    handle: AnyWindowHandle,
+    cx: &mut crate::AsyncApp,
+    update: fn(&mut Window, &mut App),
+) {
+    let Err(error) = handle.update(cx, |_, window, cx| update(window, cx)) else {
+        return;
+    };
+    if !error.is::<std::cell::BorrowMutError>() {
+        Result::<(), _>::Err(error).log_err();
+        return;
+    }
+    let executor = cx.foreground_executor().clone();
+    let mut cx = cx.clone();
+    executor
+        .spawn(async move {
+            handle
+                .update(&mut cx, |_, window, cx| update(window, cx))
+                .log_err();
+        })
+        .detach();
 }
 
