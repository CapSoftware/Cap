+    fn frame_request_toggle(&self) -> Option<Box<dyn Fn(bool)>> {
+        let window_state = Arc::downgrade(&self.0);
+        Some(Box::new(move |enabled| {
+            let Some(window_state) = window_state.upgrade() else {
+                return;
+            };
+            let mut lock = window_state.lock();
+            lock.frame_requests_paused = !enabled;
+            if !enabled {
+                lock.stop_display_link();
+                return;
+            }
+            lock.start_display_link();
+            // A restarted display link first fires a refresh or two later, so
+            // draw the frame that woke the window right away instead.
+            let window_state = Arc::downgrade(&window_state);
+            lock.foreground_executor
+                .spawn(async move {
+                    let Some(window_state) = window_state.upgrade() else {
+                        return;
+                    };
+                    let Some(mut callback) = window_state.lock().request_frame_callback.take()
+                    else {
+                        return;
+                    };
+                    callback(Default::default());
+                    window_state.lock().request_frame_callback = Some(callback);
+                })
+                .detach();
+        }))
+    }
