+
+/// Stops the platform's frame requests once a window has had nothing to draw
+/// for [`FramePacer::IDLE_DELAY`], and restarts them as soon as anything
+/// invalidates the window or schedules a next-frame callback. Without this an
+/// idle window still wakes the main thread on every display refresh.
+pub(crate) struct FramePacer {
+    toggle: Option<Box<dyn Fn(bool)>>,
+    paused: Cell<bool>,
+    busy_at: Cell<Instant>,
+}
+
+impl FramePacer {
+    /// Long enough that steady low-rate redraws (30fps video, timers) never
+    /// stop and restart the frame source between frames.
+    const IDLE_DELAY: Duration = Duration::from_millis(100);
+
+    fn new(toggle: Option<Box<dyn Fn(bool)>>) -> Self {
+        FramePacer {
+            toggle,
+            paused: Cell::new(false),
+            busy_at: Cell::new(Instant::now()),
+        }
+    }
+
+    fn wake(&self) {
+        if let Some(toggle) = &self.toggle
+            && self.paused.replace(false)
+        {
+            self.busy_at.set(Instant::now());
+            toggle(true);
+        }
+    }
+
+    fn frame_finished(&self, busy: bool, now: Instant) {
+        let Some(toggle) = &self.toggle else {
+            return;
+        };
+        if busy {
+            self.busy_at.set(now);
+        } else if now.duration_since(self.busy_at.get()) >= Self::IDLE_DELAY
+            && !self.paused.replace(true)
+        {
+            toggle(false);
+        }
+    }
 }
 
