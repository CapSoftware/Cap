+/// Asks every window whose frame requests are running for a frame. Device-lost
+/// recovery still reaches paused windows: it sends its messages to all of them.
+fn redraw_unpaused_windows(all_windows: &[SafeHwnd], paused_windows: &[SafeHwnd]) {
+    for hwnd in all_windows {
+        if paused_windows
+            .iter()
+            .any(|paused| paused.as_raw() == hwnd.as_raw())
+        {
+            continue;
+        }
+        unsafe {
+            let _ = RedrawWindow(Some(hwnd.as_raw()), None, None, RDW_INVALIDATE);
+        }
+    }
+}
