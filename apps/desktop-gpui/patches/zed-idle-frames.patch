+    /// Dispatches everything queued for this thread and returns the recorded
+    /// messages, including the ones `SendMessageW` delivered directly.
+    fn drain_messages() -> Vec<(usize, u32)> {
+        let mut msg = MSG::default();
+        while unsafe { PeekMessageW(&mut msg, None, 0, 0, PM_REMOVE) }.as_bool() {
+            unsafe { DispatchMessageW(&msg) };
+        }
+        let mut messages = MESSAGES.with(|messages| std::mem::take(&mut *messages.borrow_mut()));
+        messages.sort();
+        messages
+    }
