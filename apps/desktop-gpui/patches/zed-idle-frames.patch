+        let paused = test_window();
+        drain_messages();
+        let all_windows: Arc<RwLock<SmallVec<[SafeHwnd; 4]>>> =
+            Arc::new(RwLock::new(smallvec![running.into(), paused.into()]));
+        let paused_windows = PausedWindows::default();
+        set_frame_requests_paused(&paused_windows, paused, true);
