+    unsafe extern "system" fn record_messages(
+        hwnd: HWND,
+        msg: u32,
+        wparam: WPARAM,
+        lparam: LPARAM,
+    ) -> LRESULT {
+        if matches!(
+            msg,
+            WM_PAINT | WM_GPUI_GPU_DEVICE_LOST | WM_GPUI_FORCE_UPDATE_WINDOW
+        ) {
+            MESSAGES.with(|messages| messages.borrow_mut().push((hwnd.0 as usize, msg)));
+        }
+        if msg == WM_PAINT {
+            unsafe { ValidateRect(Some(hwnd), None).ok().log_err() };
+            return LRESULT(0);
+        }
+        unsafe { DefWindowProcW(hwnd, msg, wparam, lparam) }
+    }
