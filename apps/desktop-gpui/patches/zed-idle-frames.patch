+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum FrameRequests {
+    /// Stop requesting frames.
+    Stop,
+    /// Request a frame every display refresh again.
+    Start,
+    /// Deliver one frame as soon as possible without restarting the
+    /// per-refresh requests.
