+    fn test_window() -> HWND {
+        static REGISTER: std::sync::Once = std::sync::Once::new();
+        let class_name = w!("GpuiFrameRequestTestWindow");
+        REGISTER.call_once(|| {
+            let wc = WNDCLASSW {
+                lpfnWndProc: Some(record_messages),
+                lpszClassName: class_name,
+                ..Default::default()
+            };
+            unsafe { RegisterClassW(&wc) };
+        });
+        unsafe {
+            CreateWindowExW(
+                WINDOW_EX_STYLE(0),
+                class_name,
+                None,
+                WS_POPUP | WS_VISIBLE,
+                0,
+                0,
+                64,
+                64,
+                None,
+                None,
+                None,
+                None,
+            )
+            .unwrap()
+        }
+    }
