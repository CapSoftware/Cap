+#[cfg(test)]
+mod mirror_tests {
+    use crate::{
+        Bounds, Corners, Edges, Hsla, Pixels, ScaledPixels, StrikethroughStyle, TestAppContext,
+        UnderlineStyle, Window, canvas, fill, point, px, size,
+    };
+
+    fn paint(
+        cx: &mut TestAppContext,
+        axis: Option<Pixels>,
+    ) -> (Vec<crate::Quad>, Vec<crate::Underline>, f32) {
+        let cx = cx.add_empty_window();
+        cx.draw(point(px(0.), px(0.)), size(px(400.), px(200.)), move |_, _| {
+            canvas(
+                |_, _, _| (),
+                move |_, _, window: &mut Window, _| {
+                    window.with_mirrored_x(axis, |window| {
+                        let mut quad = fill(
+                            Bounds::new(point(px(10.), px(20.)), size(px(30.), px(40.))),
+                            Hsla::red(),
+                        );
+                        quad.corner_radii = Corners {
+                            top_left: px(1.),
+                            top_right: px(2.),
+                            bottom_right: px(3.),
+                            bottom_left: px(4.),
+                        };
+                        quad.border_widths = Edges {
+                            top: px(0.),
+                            right: px(3.),
+                            bottom: px(0.),
+                            left: px(1.),
+                        };
+                        window.paint_quad(quad);
+                        window.paint_underline(
+                            point(px(50.), px(80.)),
+                            px(60.),
+                            &UnderlineStyle {
+                                thickness: px(1.),
+                                ..Default::default()
+                            },
+                        );
+                        window.paint_strikethrough(
+                            point(px(50.), px(90.)),
+                            px(60.),
+                            &StrikethroughStyle {
+                                thickness: px(1.),
+                                ..Default::default()
+                            },
+                        );
+                    });
+                },
+            )
+        });
+        cx.update(|window, _| {
+            let scene = &window.next_frame.scene;
+            (
+                scene.quads.clone(),
+                scene.underlines.clone(),
+                window.scale_factor(),
+            )
+        })
+    }
+
+    #[crate::test]
+    fn mirror_reflects_quads_and_decorations_about_the_axis(cx: &mut TestAppContext) {
+        let (plain_quads, plain_lines, scale) = paint(cx, None);
+        let (quads, lines, _) = paint(cx, Some(px(100.)));
+        let s = |value: f32| ScaledPixels(value * scale);
+
+        let quad = &plain_quads[0];
+        assert_eq!(quad.bounds.origin.x, s(10.));
+        assert_eq!(quad.corner_radii.top_left, s(1.));
+
+        let quad = &quads[0];
+        assert_eq!(quad.bounds.origin.x, s(200. - 10. - 30.));
+        assert_eq!(quad.bounds.origin.y, s(20.));
+        assert_eq!(quad.bounds.size.width, s(30.));
+        assert_eq!(quad.corner_radii.top_left, s(2.));
+        assert_eq!(quad.corner_radii.top_right, s(1.));
+        assert_eq!(quad.corner_radii.bottom_left, s(3.));
+        assert_eq!(quad.corner_radii.bottom_right, s(4.));
+        assert_eq!(quad.border_widths.left.0.round(), s(3.).0.round());
+        assert_eq!(quad.border_widths.right.0.round(), s(1.).0.round());
+
+        assert_eq!(plain_lines.len(), 2);
+        for (plain, mirrored) in plain_lines.iter().zip(&lines) {
+            assert_eq!(plain.bounds.origin.x, s(50.));
+            assert_eq!(mirrored.bounds.origin.x, s(200. - 50. - 60.));
+            assert_eq!(mirrored.bounds.size, plain.bounds.size);
+        }
+    }
+
+    #[crate::test]
+    fn mirror_flips_glyph_sprites_onto_the_reflected_box(cx: &mut TestAppContext) {
+        let cx = cx.add_empty_window();
+        cx.update(|window, _| {
+            assert!(window.mirror_sprite_transformation().is_none());
+            let scale = window.scale_factor();
+            window.with_mirrored_x(Some(px(100.)), |window| {
+                let matrix = window.mirror_sprite_transformation().unwrap();
+                let apply = |x: f32, y: f32| {
+                    let m = matrix.rotation_scale;
+                    (
+                        m[0][0] * x + m[0][1] * y + matrix.translation[0],
+                        m[1][0] * x + m[1][1] * y + matrix.translation[1],
+                    )
+                };
+                let (left, top) = (10. * scale, 20. * scale);
+                let (right, bottom) = (left + 8. * scale, top + 12. * scale);
+                assert_eq!(apply(left, top), (200. * scale - left, top));
+                assert_eq!(apply(right, bottom), (200. * scale - right, bottom));
+            });
+            assert!(window.mirror_sprite_transformation().is_none());
+        });
+    }
