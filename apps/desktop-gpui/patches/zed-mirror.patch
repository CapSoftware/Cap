+    /// Paints `f` mirrored left to right about the vertical line at `axis`, in
+    /// window coordinates, the way CSS `scale-x: -1` mirrors an element about
+    /// its centre. Glyphs are flipped; quads, underlines and strikethroughs
+    /// are reflected; emoji are placed mirrored but keep their orientation.
+    /// Hit testing is not mirrored, so an element that maps pointer positions
+    /// to content must reflect them itself. Nested calls do not compose: the
+    /// innermost axis applies.
+    pub fn with_mirrored_x<R>(
+        &mut self,
+        axis: Option<Pixels>,
+        f: impl FnOnce(&mut Self) -> R,
+    ) -> R {
+        let Some(axis) = axis else {
+            return f(self);
+        };
+        let previous = self.element_mirror_x.replace(axis);
+        let result = f(self);
+        self.element_mirror_x = previous;
+        result
+    }
+
+    /// The mirror axis doubled, in device pixels and whole, so a reflected
+    /// glyph or quad that was pixel-aligned stays pixel-aligned.
+    fn mirror_span_scaled(&self) -> Option<ScaledPixels> {
+        self.element_mirror_x
+            .map(|axis| ScaledPixels((axis.0 * 2. * self.scale_factor()).round()))
+    }
+
+    fn mirror_x(&self, x: Pixels, width: Pixels) -> Pixels {
+        match self.mirror_span_scaled() {
+            Some(span) => Pixels(span.0 / self.scale_factor()) - x - width,
+            None => x,
+        }
     }
 
