+#[cfg(test)]
+mod reused_element_state_tests {
+    use crate::{
+        AnyView, AnyWindowHandle, AppContext as _, Context, Entity, EntityId, IntoElement,
+        ParentElement as _, Render, StyleRefinement, Styled as _, TestAppContext, Window, canvas,
+        div,
+    };
+    use std::{cell::Cell, rc::Rc};
+
+    struct Child {
+        seen: Rc<Cell<Option<EntityId>>>,
+    }
+
+    impl Render for Child {
+        fn render(&mut self, _: &mut Window, _: &mut Context<Self>) -> impl IntoElement {
+            let seen = self.seen.clone();
+            div().size_full().child(
+                canvas(
+                    move |_, window, cx| {
+                        let state = window.use_keyed_state("reused-state", cx, |_, _| 0usize);
+                        seen.set(Some(state.entity_id()));
+                    },
+                    |_, _, _, _| {},
+                )
+                .size_full(),
+            )
+        }
+    }
+
+    struct Root {
+        child: Entity<Child>,
+    }
+
+    impl Render for Root {
+        fn render(&mut self, _: &mut Window, _: &mut Context<Self>) -> impl IntoElement {
+            div().size_full().child(
+                AnyView::from(self.child.clone()).cached(StyleRefinement::default().size_full()),
+            )
+        }
+    }
+
+    /// A cached view that is reused for a frame (its elements do not run) must
+    /// still hand its element state to the frame after, where it renders again.
+    #[test]
+    fn element_state_survives_frames_that_reuse_its_view() {
+        let mut cx = TestAppContext::single();
+        let seen = Rc::new(Cell::new(None));
+        let child = cx.new({
+            let seen = seen.clone();
+            |_| Child { seen }
+        });
+        let root = cx.add_window({
+            let child = child.clone();
+            move |_, _| Root { child }
+        });
+        let window: AnyWindowHandle = root.into();
+        let draw = |cx: &mut TestAppContext| {
+            cx.update_window(window, |_, window, cx| window.draw(cx).clear())
+                .unwrap();
+        };
+
+        draw(&mut cx);
+        let first = seen.take().expect("the child paints on the first frame");
+
+        // Only the root re-renders: the cached child is reused on these frames.
+        for _ in 0..3 {
+            root.update(&mut cx, |_, _, cx| cx.notify()).unwrap();
+            draw(&mut cx);
+            assert_eq!(
+                seen.take(),
+                None,
+                "the cached child should have been reused"
+            );
+        }
+
+        // The child renders again and finds the state it created on the first frame.
+        child.update(&mut cx, |_, cx| cx.notify());
+        draw(&mut cx);
+        assert_eq!(seen.take(), Some(first));
+
+        // And a frame where nothing is reused keeps it too.
+        cx.update_window(window, |_, window, cx| {
+            window.refresh();
+            window.draw(cx).clear();
+        })
+        .unwrap();
+        child.update(&mut cx, |_, cx| cx.notify());
+        draw(&mut cx);
+        assert_eq!(seen.take(), Some(first));
+    }
+}
