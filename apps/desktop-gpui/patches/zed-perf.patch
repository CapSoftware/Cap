+    use super::stable_sort_by_key;
+    use rand::{Rng as _, SeedableRng as _, rngs::StdRng};
+
+    #[derive(Clone, Copy, Debug, PartialEq, Eq)]
+    struct Item {
+        order: u32,
+        tile: u32,
+        payload: u32,
+    }
+
+    fn check(items: Vec<Item>) {
+        let mut expected = items.clone();
+        expected.sort_by_key(|item| (item.order, item.tile));
+        let mut actual = items;
+        let mut scratch = Vec::new();
+        stable_sort_by_key(&mut actual, &mut scratch, |item| {
+            ((item.order as u64) << 32) | item.tile as u64
+        });
+        assert_eq!(actual, expected);
+    }
+
+    #[test]
+    fn matches_the_stable_sort_on_random_input() {
+        let mut rng = StdRng::seed_from_u64(7);
+        for len in [0, 1, 2, 3, 7, 31, 64, 500, 4_000] {
+            for key_range in [1, 3, 50, u32::MAX] {
+                let items = (0..len)
+                    .map(|payload| Item {
+                        order: rng.random_range(0..key_range.min(64)),
+                        tile: rng.random_range(0..key_range),
+                        payload,
+                    })
+                    .collect();
+                check(items);
+            }
+        }
+    }
+
+    #[test]
+    fn matches_the_stable_sort_on_sorted_and_reversed_input() {
+        let sorted: Vec<Item> = (0..300)
+            .map(|payload| Item {
+                order: payload / 7,
+                tile: payload % 5,
+                payload,
+            })
+            .collect();
+        check(sorted.clone());
+        check(sorted.iter().rev().copied().collect());
+        check(
+            (0..300)
+                .map(|payload| Item {
+                    order: 4,
+                    tile: 9,
+                    payload,
+                })
+                .collect(),
+        );
+        check(
+            (0..100)
+                .map(|payload| Item {
+                    order: u32::MAX - payload % 3,
+                    tile: u32::MAX - payload % 2,
+                    payload,
+                })
+                .collect(),
+        );
+    }
+}
