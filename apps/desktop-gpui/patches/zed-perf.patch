index 0000000..9688c50
--- /dev/null
+++ b/crates/gpui/src/text_system/paint_tests.rs
@@ -0,0 +1,260 @@
+//! Scene-level tests for painting shaped text: every glyph sprite must carry
+//! the rendering inputs (dilation) of its own color, background runs must
+//! still paint, and cache hits must return the very layout a miss produced.
+
+use std::{borrow::Cow, rc::Rc, sync::Arc};
+
+use crate::{
+    AnyWindowHandle, App, AppCell, AppContext as _, BackgroundExecutor, Bounds, Context,
+    DevicePixels, Font, FontId, FontMetrics, FontRun, ForegroundExecutor, GlyphId, Hsla,
+    IntoElement, LineLayout, NoopTextSystem, ParentElement as _, Pixels, PlatformTextSystem,
+    RenderGlyphParams, Result, Size, StyledText, TestAppContext, TestDispatcher, TestPlatform,
+    TextRenderingMode, TextRun, Window, WindowBounds, WindowOptions, WindowTextSystem,
+    app::GpuiMode, div, font, hsla, point, px, size,
+};
+
+// For the `#[crate::test]` macro, which expands to `gpui::` paths.
+use crate as gpui;
+
+/// The no-op text system, except that glyphs rasterize to a non-empty tile
+/// whose width encodes the dilation they were rendered with, and dilation
+/// follows the color's lightness.
+struct RasterizingTextSystem(NoopTextSystem);
+
+fn dilation_for(color: Hsla) -> u8 {
+    (color.l * 4.0).round() as u8
+}
+
+impl PlatformTextSystem for RasterizingTextSystem {
+    fn add_fonts(&self, fonts: Vec<Cow<'static, [u8]>>) -> Result<()> {
+        self.0.add_fonts(fonts)
+    }
+
+    fn all_font_names(&self) -> Vec<String> {
+        self.0.all_font_names()
+    }
+
+    fn font_id(&self, descriptor: &Font) -> Result<FontId> {
+        self.0.font_id(descriptor)
+    }
+
+    fn font_metrics(&self, font_id: FontId) -> FontMetrics {
+        self.0.font_metrics(font_id)
+    }
+
+    fn typographic_bounds(&self, font_id: FontId, glyph_id: GlyphId) -> Result<Bounds<f32>> {
+        self.0.typographic_bounds(font_id, glyph_id)
+    }
+
+    fn advance(&self, font_id: FontId, glyph_id: GlyphId) -> Result<Size<f32>> {
+        self.0.advance(font_id, glyph_id)
+    }
+
+    fn glyph_for_char(&self, font_id: FontId, ch: char) -> Option<GlyphId> {
+        self.0.glyph_for_char(font_id, ch)
+    }
+
+    fn glyph_raster_bounds(&self, params: &RenderGlyphParams) -> Result<Bounds<DevicePixels>> {
+        Ok(Bounds {
+            origin: point(DevicePixels(0), DevicePixels(-8)),
+            size: size(DevicePixels(1 + params.dilation as i32), DevicePixels(8)),
+        })
+    }
+
+    fn rasterize_glyph(
+        &self,
+        _params: &RenderGlyphParams,
+        raster_bounds: Bounds<DevicePixels>,
+    ) -> Result<(Size<DevicePixels>, Vec<u8>)> {
+        let len = (raster_bounds.size.width.0 * raster_bounds.size.height.0) as usize;
+        Ok((raster_bounds.size, vec![255; len]))
+    }
+
+    fn layout_line(&self, text: &str, font_size: Pixels, runs: &[FontRun]) -> LineLayout {
+        self.0.layout_line(text, font_size, runs)
+    }
+
+    fn recommended_rendering_mode(&self, font_id: FontId, font_size: Pixels) -> TextRenderingMode {
+        self.0.recommended_rendering_mode(font_id, font_size)
+    }
+
+    fn glyph_dilation_for_color(&self, color: Hsla) -> u8 {
+        dilation_for(color)
+    }
+}
+
+fn app_with_rasterizing_text_system() -> Rc<AppCell> {
+    let dispatcher = Arc::new(TestDispatcher::new(0));
+    let background_executor = BackgroundExecutor::new(dispatcher.clone());
+    let foreground_executor = ForegroundExecutor::new(dispatcher);
+    let platform = TestPlatform::with_text_system(
+        background_executor,
+        foreground_executor,
+        Arc::new(RasterizingTextSystem(NoopTextSystem)),
+    );
+    let app = App::new_app(
+        platform,
+        Arc::new(()),
+        http_client::FakeHttpClient::with_404_response(),
+    );
+    app.borrow_mut().mode = GpuiMode::test();
+    app
+}
+
+struct Text {
+    text: &'static str,
+    runs: Vec<TextRun>,
+}
+
+impl crate::Render for Text {
+    fn render(&mut self, _: &mut Window, _: &mut Context<Self>) -> impl IntoElement {
+        div().child(StyledText::new(self.text).with_runs(self.runs.clone()))
+    }
+}
+
+fn run(len: usize, color: Hsla, background_color: Option<Hsla>) -> TextRun {
+    TextRun {
+        len,
+        font: font("Test"),
+        color,
+        background_color,
+        underline: None,
+        strikethrough: None,
+    }
+}
+
+/// Paints `text` with `runs` on one line and returns, per monochrome sprite
+/// from left to right, its color and the dilation encoded in its tile width,
+/// plus the solid color of every quad in the scene (in paint order).
+fn paint(text: &'static str, runs: Vec<TextRun>) -> (Vec<(Hsla, u8)>, Vec<Hsla>) {
+    let app = app_with_rasterizing_text_system();
+    let mut app = app.borrow_mut();
+    let cx: &mut App = &mut app;
+    let window: AnyWindowHandle = cx
+        .open_window(
+            WindowOptions {
+                window_bounds: Some(WindowBounds::Windowed(Bounds {
+                    origin: point(px(0.), px(0.)),
+                    size: size(px(800.), px(600.)),
+                })),
+                ..Default::default()
+            },
+            |_, cx| cx.new(|_| Text { text, runs }),
+        )
+        .expect("open test window")
+        .into();
+    // The untyped handle leaves the root view unleased, so `draw` can render it.
+    window
+        .update(cx, |_, window, cx| {
+            window.draw(cx).clear();
+            let scene = &window.rendered_frame.scene;
+            let mut sprites: Vec<_> = scene.monochrome_sprites.iter().collect();
+            // The scene orders sprites by tile, not by position.
+            sprites.sort_by(|a, b| a.bounds.origin.x.0.total_cmp(&b.bounds.origin.x.0));
+            let glyphs = sprites
+                .into_iter()
+                .map(|sprite| (sprite.color, (sprite.bounds.size.width.0 as i32 - 1) as u8))
+                .collect();
+            let backgrounds = scene
+                .quads
+                .iter()
+                .map(|quad| quad.background.solid)
+                .collect();
+            (glyphs, backgrounds)
+        })
+        .expect("draw test window")
+}
+
+#[test]
+fn every_glyph_is_rendered_with_the_dilation_of_its_own_color() {
+    let dark = hsla(0., 0., 0., 1.);
+    let light = hsla(0., 0., 1., 1.);
+    let mid = hsla(0.6, 0.5, 0.5, 1.);
+    assert_ne!(dilation_for(dark), dilation_for(light));
+    assert_ne!(dilation_for(dark), dilation_for(mid));
+
+    // Colors alternate run to run, so a dilation remembered for the wrong
+    // color would show up on the glyphs after every switch.
+    let text = "aaabbbcccdddeee";
+    let runs = vec![
+        run(3, dark, None),
+        run(3, light, None),
+        run(3, dark, None),
+        run(3, mid, None),
+        run(3, light, None),
+    ];
+    let (glyphs, _) = paint(text, runs);
+
+    let expected_colors = [dark, light, dark, mid, light]
+        .into_iter()
+        .flat_map(|color| [color; 3])
+        .collect::<Vec<_>>();
+    assert_eq!(glyphs.len(), text.len());
+    for (ix, ((color, dilation), expected_color)) in glyphs.iter().zip(&expected_colors).enumerate()
+    {
+        assert_eq!(color, expected_color, "glyph {ix} color");
+        assert_eq!(*dilation, dilation_for(*color), "glyph {ix} dilation");
+    }
+}
+
+#[test]
+fn text_without_background_runs_paints_no_quads() {
+    let color = hsla(0., 0., 0.2, 1.);
+    let (glyphs, backgrounds) = paint("no backgrounds here", vec![run(19, color, None)]);
+    assert_eq!(glyphs.len(), 19);
+    assert!(backgrounds.is_empty(), "unexpected quads: {backgrounds:?}");
+}
+
+#[test]
+fn background_runs_still_paint_their_quads() {
+    let color = hsla(0., 0., 0.2, 1.);
+    let highlight = hsla(0.15, 1., 0.5, 1.);
+    let other = hsla(0.55, 1., 0.5, 1.);
+    let (glyphs, backgrounds) = paint(
+        "plain highlighted plain other",
+        vec![
+            run(6, color, None),
+            run(12, color, Some(highlight)),
+            run(6, color, None),
+            run(5, color, Some(other)),
+        ],
+    );
+    assert_eq!(glyphs.len(), 29);
+    assert_eq!(backgrounds, vec![highlight, other]);
+}
+
+#[crate::test]
+fn shaped_and_laid_out_lines_share_one_cached_layout(cx: &mut TestAppContext) {
+    cx.update(|cx| {
+        let text_system = WindowTextSystem::new(cx.text_system().clone());
+        // Longer than an inline `SharedString`, so a copy would be a new heap string.
+        let text = "a line comfortably longer than twenty-three bytes";
+        let runs = [TextRun {
+            len: text.len(),
+            font: font("Test"),
+            color: Default::default(),
+            background_color: None,
+            underline: None,
+            strikethrough: None,
+        }];
+
+        let shaped = text_system.shape_line(text.into(), px(14.), &runs, None);
+        let laid_out = text_system.layout_line(text, px(14.), &runs, None);
+        let shaped_again = text_system.shape_line(text.into(), px(14.), &runs, None);
+        assert!(Arc::ptr_eq(&shaped.layout, &laid_out));
+        assert!(Arc::ptr_eq(&shaped.layout, &shaped_again.layout));
+        assert_eq!(shaped.text.as_ref(), text);
+
+        // The next frame reuses the previous frame's layout for both entry points.
+        text_system.finish_frame();
+        let laid_out_next_frame = text_system.layout_line(text, px(14.), &runs, None);
+        let shaped_next_frame = text_system.shape_line(text.into(), px(14.), &runs, None);
+        assert!(Arc::ptr_eq(&shaped.layout, &laid_out_next_frame));
+        assert!(Arc::ptr_eq(&shaped.layout, &shaped_next_frame.layout));
+
+        // Different text is a different layout.
+        let other =
+            text_system.layout_line("something else entirely, also long", px(14.), &runs, None);
+        assert!(!Arc::ptr_eq(&shaped.layout, &other));
+    });
+}
