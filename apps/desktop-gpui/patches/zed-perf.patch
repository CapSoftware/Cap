+    fn check_against_brute_force(tree: &mut BoundsTree<f32>, all: &[Bounds<f32>]) {
+        tree.clear();
+        let mut inserted: Vec<(Bounds<f32>, u32)> = Vec::with_capacity(all.len());
+        for (ix, bounds) in all.iter().enumerate() {
+            let expected = inserted
+                .iter()
+                .filter(|(other, _)| other.intersects(bounds))
+                .map(|(_, order)| *order)
+                .max()
+                .unwrap_or(0)
+                + 1;
+            let actual = tree.insert(*bounds);
+            assert_eq!(actual, expected, "ordering of bounds #{ix}: {bounds:?}");
+            inserted.push((*bounds, actual));
+        }
+    }
