+        let mut cards = vec![bounds(0., 0., 1920., 1080.)];
+        for row in 0..30 {
+            for column in 0..10 {
+                let x = 16. + column as f32 * 188.;
+                let y = 16. + row as f32 * 72.;
+                cards.push(bounds(x, y, 180., 64.));
+                cards.push(bounds(x, y, 180., 1.));
+                for glyph in 0..12 {
+                    cards.push(bounds(x + 8. + glyph as f32 * 7., y + 8., 7., 14.));
+                }
+                cards.push(bounds(x + 150., y + 4., 26., 26.));
+            }
+        }
+        check_against_brute_force(&mut tree, &cards);
+
+        let mut rows = Vec::new();
