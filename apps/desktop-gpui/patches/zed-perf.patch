+fn sprite_sort_key(sprite: &MonochromeSprite) -> u64 {
+    order_and_tile_key(sprite.order, sprite.tile.tile_id)
+}
+
+fn order_and_tile_key(order: DrawOrder, tile_id: crate::TileId) -> u64 {
+    ((order as u64) << 32) | tile_id.0 as u64
+}
+
+/// Equivalent to the stable `items.sort_by_key(key)`, but moves each ~100-byte
+/// primitive once instead of several times. No two pairs share an index, so the
+/// unstable sort of `(key, index)` orders equal keys by original position.
+fn stable_sort_by_key<T: Copy>(
+    items: &mut [T],
+    scratch: &mut Vec<(u64, u32)>,
+    key: impl Fn(&T) -> u64,
+) {
+    if items.len() < 2 {
+        return;
+    }
+    debug_assert!(items.len() <= u32::MAX as usize);
+    scratch.clear();
+    scratch.extend(
+        items
+            .iter()
+            .enumerate()
+            .map(|(index, item)| (key(item), index as u32)),
+    );
+    if scratch.windows(2).all(|pair| pair[0].0 <= pair[1].0) {
+        return;
+    }
+    scratch.sort_unstable();
+
+    const DONE: u32 = u32::MAX;
+    for start in 0..items.len() {
+        if scratch[start].1 == DONE {
+            continue;
+        }
+        let first = items[start];
+        let mut slot = start;
+        loop {
+            let source = scratch[slot].1 as usize;
+            scratch[slot].1 = DONE;
+            if source == start {
+                items[slot] = first;
+                break;
+            }
+            items[slot] = items[source];
+            slot = source;
+        }
+    }
+}
+
+#[cfg(test)]
