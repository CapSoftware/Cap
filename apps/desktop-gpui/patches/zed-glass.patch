+                let ring = (1.5 - d).clamp(0., 1.) - coverage;
+                let (nx, ny) = {
+                    let dx = sdf(px + 0.5, py) - sdf(px - 0.5, py);
+                    let dy = sdf(px, py + 0.5) - sdf(px, py - 0.5);
