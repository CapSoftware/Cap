+    /// of 1 and nothing else. The struct stays a multiple of 8 bytes, which
+    /// WGSL's storage layout requires of `BackdropBlur`.
+    pub tint_scale: [f32; 3],
+    pub tint_luma: [f32; 3],
+    pub tint_offset: [f32; 3],
