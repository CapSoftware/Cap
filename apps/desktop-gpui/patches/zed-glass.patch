+        let blurred = gaussian_blur(&backdrop, sigma);
+        let width = VIEW_W;
+        let sample = |x: f32, y: f32| -> [f32; 4] {
+            let fx = (x - 0.5).clamp(0., (VIEW_W - 1) as f32);
+            let fy = (y - 0.5).clamp(0., (VIEW_H - 1) as f32);
+            let (x0, y0) = (fx.floor() as i32, fy.floor() as i32);
+            let (x1, y1) = ((x0 + 1).min(VIEW_W - 1), (y0 + 1).min(VIEW_H - 1));
+            let (tx, ty) = (fx - x0 as f32, fy - y0 as f32);
+            let at = |x: i32, y: i32| blurred[(y * width + x) as usize];
+            let (a, b, c, d) = (at(x0, y0), at(x1, y0), at(x0, y1), at(x1, y1));
+            std::array::from_fn(|i| {
+                let top = a[i] + (b[i] - a[i]) * tx;
+                top + (c[i] + (d[i] - c[i]) * tx - top) * ty
