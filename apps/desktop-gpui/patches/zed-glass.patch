+/*
+**
+**              Backdrop blur and glass
+**
+*/
+
+// Mirrors gpui's `GlassStyle`; `line` is reserved in HLSL, hence
+// `line_strength` for the same field.
+struct GlassStyle {
+    uint enabled;
+    float lens_rim;
+    float lens_curve;
+    float rim_bend;
+    float poly[60];
+    float opacity;
+    float line_strength;
+    float line_lit;
+    float line_width;
+    float light_x;
+    float light_y;
+    float glow;
+    float glow_width;
+    float hairline[4];
+    float tint_scale[3];
+    float tint_luma[3];
+    float tint_offset[3];
+    float pad;
+};
+
+struct BackdropBlur {
+    uint order;
+    float blur_radius;
+    Bounds bounds;
+    Bounds content_mask;
+    Corners corner_radii;
+    GlassStyle glass;
+};
+
+// One constant buffer serves every backdrop pass. For the downsample and
+// blur passes `source_rect` is the texel rect of the source texture being
+// read and `params` is (direction x, direction y, sigma in source texels or
+// the downsample factor, unused). For the glass pass `source_rect` is the
+// drawable rect that was blurred, `params.xy` how far it was scaled down on
+// each axis (the blurred texture holds it from texel 0), and
+// `sharp_texture_size` the size of the drawable-sized unblurred copy.
+cbuffer BackdropParams: register(b1) {
+    float4 source_rect;
+    float4 params;
+    float2 source_texture_size;
+    float2 sharp_texture_size;
+};
+
+Texture2D<float4> t_backdrop: register(t2);
+Texture2D<float4> t_backdrop_sharp: register(t3);
+SamplerState s_backdrop: register(s1);
+
+struct BackdropPassOutput {
+    float4 position: SV_Position;
+    float2 uv: TEXCOORD0;
+};
+
+BackdropPassOutput backdrop_pass_vertex(uint vertex_id: SV_VertexID) {
+    float2 uv = float2((vertex_id << 1) & 2, vertex_id & 2);
+    BackdropPassOutput output;
+    output.position = float4(uv * float2(2., -2.) + float2(-1., 1.), 0., 1.);
+    output.uv = uv;
+    return output;
+}
+
+BackdropPassOutput backdrop_downsample_vertex(uint vertex_id: SV_VertexID) {
+    return backdrop_pass_vertex(vertex_id);
+}
+
+BackdropPassOutput backdrop_blur_pass_vertex(uint vertex_id: SV_VertexID) {
+    return backdrop_pass_vertex(vertex_id);
+}
+
+float2 backdrop_source_uv(float2 uv) {
+    return (source_rect.xy + uv * source_rect.zw) / source_texture_size;
+}
+
+float4 backdrop_downsample_fragment(BackdropPassOutput input): SV_Target {
+    float2 texel = 1. / source_texture_size;
+    float2 center = backdrop_source_uv(input.uv);
+    float2 quarter = texel * params.z * 0.25;
+    float2 lo = (source_rect.xy + 0.5) * texel;
+    float2 hi = (source_rect.xy + source_rect.zw - 0.5) * texel;
+    float4 sum = t_backdrop.SampleLevel(s_backdrop, clamp(center + float2(-quarter.x, -quarter.y), lo, hi), 0);
+    sum += t_backdrop.SampleLevel(s_backdrop, clamp(center + float2(quarter.x, -quarter.y), lo, hi), 0);
+    sum += t_backdrop.SampleLevel(s_backdrop, clamp(center + float2(-quarter.x, quarter.y), lo, hi), 0);
+    sum += t_backdrop.SampleLevel(s_backdrop, clamp(center + float2(quarter.x, quarter.y), lo, hi), 0);
+    return 0.25 * sum;
+}
+
+float4 backdrop_blur_pass_fragment(BackdropPassOutput input): SV_Target {
+    float sigma = max(params.z, 0.5);
+    int radius = (int)ceil(sigma * 3.);
+    float2 step = params.xy / source_texture_size;
+    float2 uv = backdrop_source_uv(input.uv);
+    float2 lo = (source_rect.xy + 0.5) / source_texture_size;
+    float2 hi = (source_rect.xy + source_rect.zw - 0.5) / source_texture_size;
+    float4 sum = 0.;
+    float total = 0.;
+    [loop]
+    for (int i = -radius; i <= radius; i++) {
+        float weight = exp(-(float)(i * i) / (2. * sigma * sigma));
+        sum += weight * t_backdrop.SampleLevel(s_backdrop, clamp(uv + step * (float)i, lo, hi), 0);
+        total += weight;
+    }
+    return sum / total;
+}
+
+StructuredBuffer<BackdropBlur> backdrop_blurs: register(t1);
+
+struct BackdropGlassVertexOutput {
+    float4 position: SV_Position;
+    nointerpolation uint blur_id: TEXCOORD0;
+    float4 clip_distance: SV_ClipDistance;
+};
+
+BackdropGlassVertexOutput backdrop_glass_vertex(uint vertex_id: SV_VertexID, uint blur_id: SV_InstanceID) {
+    float2 unit_vertex = float2(float(vertex_id & 1u), 0.5 * float(vertex_id & 2u));
+    BackdropBlur blur = backdrop_blurs[blur_id];
+    // Glass draws a hairline in the pixel ring just outside its edge.
+    Bounds bounds = blur.bounds;
+    if (blur.glass.enabled != 0u) {
+        bounds.origin -= 2.;
+        bounds.size += 4.;
+    }
+    BackdropGlassVertexOutput output;
+    output.position = to_device_position(unit_vertex, bounds);
+    output.blur_id = blur_id;
+    output.clip_distance = distance_from_clip_rect(unit_vertex, bounds, blur.content_mask);
+    return output;
+}
+
+// Clamped to the blurred region: texels beyond it hold an older pass.
+float2 backdrop_blurred_uv(float2 position) {
+    float2 texel = (position - source_rect.xy) / params.xy;
+    texel = clamp(texel, 0.5, source_rect.zw / params.xy - 0.5);
+    return texel / source_texture_size;
+}
+
+float4 backdrop_glass_fragment(BackdropGlassVertexOutput input): SV_Target {
+    BackdropBlur blur = backdrop_blurs[input.blur_id];
+    float2 position = input.position.xy;
+    float distance = quad_sdf(position, blur.bounds, blur.corner_radii);
+
+    if (blur.glass.enabled == 0u) {
+        if (distance > 0.) {
+            discard;
+        }
+        return t_backdrop.SampleLevel(s_backdrop, backdrop_blurred_uv(position), 0);
+    }
+
+    float coverage = saturate(0.5 - distance);
+    float ring = saturate(1.5 - distance) - coverage;
+    if (coverage <= 0. && ring <= 0.) {
+        discard;
+    }
+    GlassStyle glass = blur.glass;
+    float edge = max(-distance, 0.);
+    float2 normal = float2(
+        quad_sdf(position + float2(0.5, 0.), blur.bounds, blur.corner_radii) -
+            quad_sdf(position - float2(0.5, 0.), blur.bounds, blur.corner_radii),
+        quad_sdf(position + float2(0., 0.5), blur.bounds, blur.corner_radii) -
+            quad_sdf(position - float2(0., 0.5), blur.bounds, blur.corner_radii));
+    normal /= max(length(normal), 1e-6);
+    float vertical = normal.x * normal.x;
+    float hair_a = lerp(glass.hairline[2], glass.hairline[0], vertical);
+    float hair_b = lerp(glass.hairline[3], glass.hairline[1], vertical);
+    float4 under = t_backdrop_sharp.SampleLevel(s_backdrop, position / sharp_texture_size, 0);
+    float3 hair_color = saturate(min(under.rgb, hair_a * under.rgb + hair_b));
+    under.rgb = lerp(under.rgb, hair_color, ring);
+    if (coverage <= 0.) {
+        return under;
+    }
+    float rim = exp(-pow(edge / glass.lens_rim, glass.lens_curve));
+    float2 sample_at = position + normal * glass.rim_bend * rim;
+    float4 backdrop = t_backdrop.SampleLevel(s_backdrop, backdrop_blurred_uv(sample_at), 0);
+    float3 color = backdrop.a > 0. ? backdrop.rgb / backdrop.a : float3(0., 0., 0.);
+    float alpha = lerp(backdrop.a, 1., glass.opacity);
+
+    float features[20] = {color.r, color.g, color.b, color.r * color.r, color.g * color.g,
+                          color.b * color.b, color.r * color.g, color.g * color.b,
+                          color.r * color.b, color.r * color.r * color.r,
+                          color.g * color.g * color.g, color.b * color.b * color.b,
+                          color.r * color.r * color.g, color.r * color.r * color.b,
+                          color.g * color.g * color.r, color.g * color.g * color.b,
+                          color.b * color.b * color.r, color.b * color.b * color.g,
+                          color.r * color.g * color.b, 1.};
+    color = float3(0., 0., 0.);
+    [unroll]
+    for (int term = 0; term < 20; term++) {
+        color += features[term] * float3(glass.poly[term], glass.poly[20 + term], glass.poly[40 + term]);
+    }
+    float facing = dot(normal, float2(glass.light_x, glass.light_y));
+    float line_term = exp(-edge / glass.line_width) * (glass.line_strength + glass.line_lit * facing);
+    float glow = exp(-edge / glass.glow_width) * glass.glow;
+    color = saturate(color * (1. + line_term) + glow);
+    float luma = dot(color, float3(0.2126, 0.7152, 0.0722));
+    color = saturate(color * float3(glass.tint_scale[0], glass.tint_scale[1], glass.tint_scale[2])
+        + luma * float3(glass.tint_luma[0], glass.tint_luma[1], glass.tint_luma[2])
+        + float3(glass.tint_offset[0], glass.tint_offset[1], glass.tint_offset[2]));
+
+    return lerp(under, float4(color * alpha, alpha), coverage);
+}
