+                        c[1],
+                        c[2],
+                        c[0] * c[0],
+                        c[1] * c[1],
+                        c[2] * c[2],
+                        c[0] * c[1],
+                        c[1] * c[2],
+                        c[0] * c[2],
+                        c[0] * c[0] * c[0],
+                        c[1] * c[1] * c[1],
+                        c[2] * c[2] * c[2],
+                        c[0] * c[0] * c[1],
+                        c[0] * c[0] * c[2],
+                        c[1] * c[1] * c[0],
+                        c[1] * c[1] * c[2],
+                        c[2] * c[2] * c[0],
+                        c[2] * c[2] * c[1],
