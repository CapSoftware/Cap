+    fn gaussian_blur(image: &RgbaImage, sigma: f32) -> Vec<[f32; 4]> {
+        let (w, h) = (image.width() as i32, image.height() as i32);
+        let radius = (sigma * 3.).ceil() as i32;
+        let weights: Vec<f32> = (-radius..=radius)
+            .map(|i| (-(i * i) as f32 / (2. * sigma * sigma)).exp())
+            .collect();
+        let total: f32 = weights.iter().sum();
+        let pass = |src: &dyn Fn(i32, i32) -> [f32; 4], horizontal: bool| -> Vec<[f32; 4]> {
+            let mut out = vec![[0.; 4]; (w * h) as usize];
+            for y in 0..h {
+                for x in 0..w {
+                    let mut acc = [0.; 4];
+                    for (k, weight) in weights.iter().enumerate() {
+                        let offset = k as i32 - radius;
+                        let (sx, sy) = if horizontal {
+                            ((x + offset).clamp(0, w - 1), y)
+                        } else {
+                            (x, (y + offset).clamp(0, h - 1))
+                        };
+                        let px = src(sx, sy);
+                        for c in 0..4 {
+                            acc[c] += px[c] * weight / total;
+                        }
+                    }
+                    out[(y * w + x) as usize] = acc;
+                }
+            }
+            out
+        };
+        let first = pass(
+            &|x, y| {
+                let p = image.get_pixel(x as u32, y as u32);
+                [p[0] as f32, p[1] as f32, p[2] as f32, p[3] as f32]
+            },
+            true,
+        );
+        pass(&|x, y| first[(y * w + x) as usize], false)
+    }
