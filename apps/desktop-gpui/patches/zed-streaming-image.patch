+        let region =
+            metal::MTLRegion::new_2d(0, 0, self.size.width.0 as u64, self.size.height.0 as u64);
+        self.slots[target].texture.replace_region(
+            region,
+            0,
+            frame.bytes().as_ptr() as *const _,
+            frame.stride() as u64,
+        );
+        self.front = target;
+        self.generation = frame.generation();
+
+        if self.uncontended_uploads >= SPARE_SLOT_RELEASE_UPLOADS && self.slots.len() > 1 {
+            self.slots.swap(0, self.front);
+            self.slots.truncate(1);
+            self.front = 0;
+            self.uncontended_uploads = 0;
+        }
