+    fn get_or_update_stream(
+        &self,
+        id: StreamingImageId,
+        frame: &StreamFrame,
+    ) -> anyhow::Result<Option<AtlasTile>> {
+        let mut state = self.0.lock();
+        let state = &mut *state;
+        if let Some((generation, tile)) = state.streams.get_mut(&id)
+            && tile.bounds.size == frame.size()
+        {
+            let tile = *tile;
+            if *generation != frame.generation() {
+                *generation = frame.generation();
+                state.stream_uploads += 1;
+            }
+            return Ok(Some(tile));
+        }
+        state.next_id += 1;
+        let tile = AtlasTile::for_stream(state.next_id, frame.size());
+        state.streams.insert(id, (frame.generation(), tile));
+        state.stream_uploads += 1;
+        Ok(Some(tile))
+    }
+
+    fn remove_stream(&self, id: StreamingImageId) {
+        let mut state = self.0.lock();
+        if state.streams.remove(&id).is_some() {
+            state.removed_streams.push(id);
+        }
+    }
 }
diff --git a/crates/gpui/src/streaming_image.rs b/crates/gpui/src/streaming_image.rs
