+        update_stream(&atlas, &image, &set_stream_frame(&image, size, 2));
+        assert_eq!(stream_slot_textures(&atlas, &image).len(), 1);
+        assert_eq!(stream_textures_created(&atlas), 2);
+        let device = atlas.0.lock().device.0.clone();
+        assert!(read_texture(&device, &held).iter().all(|&byte| byte == 1));
+        drop(lease);
+    }
 }
