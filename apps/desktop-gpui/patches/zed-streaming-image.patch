+    /// Writes `frame` into a slot no command buffer is reading and makes it
+    /// the front slot, without ever waiting on the GPU. Returns how many
+    /// textures it created.
+    fn upload(
+        &mut self,
+        device: &metal::DeviceRef,
+        is_apple_gpu: bool,
+        frame: &StreamFrame,
+    ) -> u32 {
+        let frame_bytes = self.size.width.0 as u64 * self.size.height.0 as u64 * 4;
+        let max_slots = if frame_bytes > SINGLE_SLOT_STREAM_BYTES {
+            1
+        } else {
+            2
+        };
+        let is_free = |slot: &MetalStreamSlot| slot.in_flight.load(Ordering::Acquire) == 0;
+        let mut created = 0;
+        let target = if self.slots.get(self.front).is_some_and(is_free) {
+            self.uncontended_uploads += 1;
+            self.front
+        } else {
+            self.uncontended_uploads = 0;
+            if let Some(index) = self.slots.iter().position(is_free) {
+                index
+            } else if self.slots.len() < max_slots {
+                created += 1;
+                self.slots.push(self.new_slot(device, is_apple_gpu));
+                self.slots.len() - 1
+            } else {
+                created += 1;
+                let index = (self.front + 1) % self.slots.len();
+                self.slots[index] = self.new_slot(device, is_apple_gpu);
+                index
+            }
+        };
