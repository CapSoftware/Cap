index 0000000..3cb3416
--- /dev/null
+++ b/crates/gpui/src/streaming_image.rs
@@ -0,0 +1,363 @@
+use crate::{DevicePixels, Size};
+use anyhow::{Context as _, Result};
+use parking_lot::Mutex;
+use std::{
+    fmt,
+    sync::{
+        Arc, Weak,
+        atomic::{AtomicU64, Ordering},
+    },
+};
+
+/// Identifies a [`StreamingImage`] for the lifetime of the process.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord, Hash)]
+pub struct StreamingImageId(pub u64);
+
+/// The byte order of a [`StreamingImage`]'s pixels.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub enum StreamingImageFormat {
+    /// Blue, green, red, alpha, the order [`RenderImage`](crate::RenderImage) uses.
+    Bgra8,
+    /// Red, green, blue, alpha.
+    Rgba8,
+}
+
+/// One frame of a [`StreamingImage`], as returned by [`StreamingImage::current`].
+#[derive(Clone)]
+pub struct StreamFrame {
+    generation: u64,
+    size: Size<DevicePixels>,
+    stride: usize,
+    format: StreamingImageFormat,
+    bytes: Arc<Vec<u8>>,
+}
+
+impl StreamFrame {
+    /// Increases every time the image receives a new frame.
+    pub fn generation(&self) -> u64 {
+        self.generation
+    }
+
+    /// The frame's size in pixels.
+    pub fn size(&self) -> Size<DevicePixels> {
+        self.size
+    }
+
+    /// The number of bytes from the start of one row to the start of the next.
+    pub fn stride(&self) -> usize {
+        self.stride
+    }
+
+    /// The byte order of the frame's pixels.
+    pub fn format(&self) -> StreamingImageFormat {
+        self.format
+    }
+
+    /// The frame's rows, [`Self::stride`] bytes apart. Holds at least
+    /// `stride * height` bytes.
+    pub fn bytes(&self) -> &[u8] {
+        &self.bytes
+    }
+}
+
+impl fmt::Debug for StreamFrame {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("StreamFrame")
+            .field("generation", &self.generation)
+            .field("size", &self.size)
+            .field("stride", &self.stride)
+            .field("format", &self.format)
+            .field("len", &self.bytes.len())
+            .finish()
+    }
+}
+
+/// An image whose pixels are replaced frame after frame, such as a video or a
+/// camera preview.
+///
+/// Each window that paints the image keeps one texture for it and uploads into
+/// that texture only when the frame has changed, instead of packing every frame
+/// into the sprite atlas as a new image. The texture is released once every
+/// handle is dropped or the image is [cleared](Self::clear).
+///
+/// Handles are cheap to clone and frames can be set from any thread.
+#[derive(Clone)]
+pub struct StreamingImage(Arc<Shared>);
+
+struct Shared {
+    id: StreamingImageId,
+    format: StreamingImageFormat,
+    state: Mutex<State>,
+}
+
+#[derive(Default)]
+struct State {
+    generation: u64,
+    frame: Option<StreamFrame>,
+    spare: Option<Vec<u8>>,
+}
+
+impl StreamingImage {
+    /// Creates an image with no frame, whose frames are in the given byte order.
+    pub fn new(format: StreamingImageFormat) -> Self {
+        static NEXT_ID: AtomicU64 = AtomicU64::new(0);
+        Self(Arc::new(Shared {
+            id: StreamingImageId(NEXT_ID.fetch_add(1, Ordering::Relaxed)),
+            format,
+            state: Mutex::default(),
+        }))
+    }
+
+    /// The image's process-wide identifier.
+    pub fn id(&self) -> StreamingImageId {
+        self.0.id
+    }
+
+    /// The byte order of the image's frames.
+    pub fn format(&self) -> StreamingImageFormat {
+        self.0.format
+    }
+
+    /// Replaces the current frame with `bytes`, whose rows are `stride` bytes
+    /// apart.
+    ///
+    /// Returns the previous frame's buffer when nothing else holds it any more,
+    /// so the producer can write the next frame into it instead of allocating.
+    pub fn set_frame(
+        &self,
+        size: Size<DevicePixels>,
+        stride: usize,
+        bytes: Vec<u8>,
+    ) -> Result<Option<Vec<u8>>> {
+        validate_frame(size, stride, bytes.len())?;
+        let previous = self.replace_frame(size, stride, bytes);
+        Ok(previous.and_then(|frame| Arc::try_unwrap(frame.bytes).ok()))
+    }
+
+    /// Copies `bytes`, whose rows are `stride` bytes apart, into a new current
+    /// frame. The copy reuses the buffer of an earlier frame once nothing else
+    /// holds it, so a steady stream of same-sized frames does not allocate.
+    pub fn copy_frame(&self, size: Size<DevicePixels>, stride: usize, bytes: &[u8]) -> Result<()> {
+        validate_frame(size, stride, bytes.len())?;
+        let len = stride * size.height.0 as usize;
+        let mut buffer = self.0.state.lock().spare.take().unwrap_or_default();
+        buffer.clear();
+        buffer.extend_from_slice(&bytes[..len]);
+        let previous = self.replace_frame(size, stride, buffer);
+        if let Some(previous) = previous.and_then(|frame| Arc::try_unwrap(frame.bytes).ok()) {
+            let mut state = self.0.state.lock();
+            if state.frame.is_some() {
+                state.spare = Some(previous);
+            }
+        }
+        Ok(())
+    }
+
+    /// The current frame, if any.
+    pub fn current(&self) -> Option<StreamFrame> {
+        self.0.state.lock().frame.clone()
+    }
+
+    /// Drops the current frame. Windows stop painting the image and release
+    /// its texture on their next draw.
+    pub fn clear(&self) {
+        let mut state = self.0.state.lock();
+        state.frame = None;
+        state.spare = None;
+    }
+
+    pub(crate) fn downgrade(&self) -> WeakStreamingImage {
+        WeakStreamingImage(Arc::downgrade(&self.0))
+    }
+
+    fn replace_frame(
+        &self,
+        size: Size<DevicePixels>,
+        stride: usize,
+        bytes: Vec<u8>,
+    ) -> Option<StreamFrame> {
+        let mut state = self.0.state.lock();
+        state.generation += 1;
+        let frame = StreamFrame {
+            generation: state.generation,
+            size,
+            stride,
+            format: self.0.format,
+            bytes: Arc::new(bytes),
+        };
+        state.frame.replace(frame)
+    }
+}
+
+impl fmt::Debug for StreamingImage {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("StreamingImage")
+            .field("id", &self.0.id)
+            .field("format", &self.0.format)
+            .finish_non_exhaustive()
+    }
+}
+
+pub(crate) struct WeakStreamingImage(Weak<Shared>);
+
+impl WeakStreamingImage {
+    pub(crate) fn has_frame(&self) -> bool {
+        self.0
+            .upgrade()
+            .is_some_and(|shared| shared.state.lock().frame.is_some())
+    }
+}
+
+fn validate_frame(size: Size<DevicePixels>, stride: usize, len: usize) -> Result<()> {
+    anyhow::ensure!(
+        size.width.0 > 0 && size.height.0 > 0,
+        "streaming image frames must not be empty, got {}x{}",
+        size.width.0,
+        size.height.0
+    );
+    let row_bytes = size.width.0 as usize * 4;
+    anyhow::ensure!(
+        stride >= row_bytes && stride.is_multiple_of(4),
+        "stride {stride} must be a multiple of 4 and at least {row_bytes} for a frame {} pixels wide",
+        size.width.0
+    );
+    let required = stride
+        .checked_mul(size.height.0 as usize)
+        .context("streaming image frame is too large")?;
+    anyhow::ensure!(
+        len >= required,
+        "a {}x{} frame with stride {stride} needs {required} bytes, got {len}",
+        size.width.0,
+        size.height.0
+    );
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::size;
+
+    fn frame_size(width: i32, height: i32) -> Size<DevicePixels> {
+        size(DevicePixels(width), DevicePixels(height))
+    }
+
+    #[test]
+    fn handles_are_send_and_sync() {
+        fn assert_send_sync<T: Send + Sync>() {}
+        assert_send_sync::<StreamingImage>();
+        assert_send_sync::<StreamFrame>();
+    }
+
+    #[test]
+    fn ids_are_unique() {
+        let first = StreamingImage::new(StreamingImageFormat::Bgra8);
+        let second = StreamingImage::new(StreamingImageFormat::Bgra8);
+        assert_ne!(first.id(), second.id());
+        assert_eq!(first.clone().id(), first.id());
+    }
+
+    #[test]
+    fn each_frame_advances_the_generation() {
+        let image = StreamingImage::new(StreamingImageFormat::Rgba8);
+        assert!(image.current().is_none());
+
+        image.set_frame(frame_size(2, 1), 8, vec![1; 8]).unwrap();
+        let first = image.current().unwrap();
+        assert_eq!(first.generation(), 1);
+        assert_eq!(first.size(), frame_size(2, 1));
+        assert_eq!(first.stride(), 8);
+        assert_eq!(first.format(), StreamingImageFormat::Rgba8);
+        assert_eq!(first.bytes(), &[1; 8]);
+
+        image.copy_frame(frame_size(1, 2), 4, &[2; 8]).unwrap();
+        let second = image.current().unwrap();
+        assert_eq!(second.generation(), 2);
+        assert_eq!(second.size(), frame_size(1, 2));
+        assert_eq!(second.bytes(), &[2; 8]);
+        assert_eq!(first.bytes(), &[1; 8]);
+    }
+
+    #[test]
+    fn set_frame_returns_the_previous_buffer_once_nothing_holds_it() {
+        let image = StreamingImage::new(StreamingImageFormat::Bgra8);
+        assert_eq!(
+            image.set_frame(frame_size(1, 1), 4, vec![1; 4]).unwrap(),
+            None
+        );
+
+        let returned = image.set_frame(frame_size(1, 1), 4, vec![2; 4]).unwrap();
+        assert_eq!(returned, Some(vec![1; 4]));
+
+        let held = image.current().unwrap();
+        let returned = image.set_frame(frame_size(1, 1), 4, vec![3; 4]).unwrap();
+        assert_eq!(returned, None);
+        assert_eq!(held.bytes(), &[2; 4]);
+    }
+
+    #[test]
+    fn copy_frame_reuses_earlier_buffers() {
+        let image = StreamingImage::new(StreamingImageFormat::Bgra8);
+        let pixels = vec![7u8; 64 * 64 * 4];
+        image.copy_frame(frame_size(64, 64), 256, &pixels).unwrap();
+        let first = image.current().unwrap().bytes().as_ptr();
+        image.copy_frame(frame_size(64, 64), 256, &pixels).unwrap();
+        let second = image.current().unwrap().bytes().as_ptr();
+        image.copy_frame(frame_size(64, 64), 256, &pixels).unwrap();
+        let third = image.current().unwrap().bytes().as_ptr();
+
+        assert_ne!(first, second);
+        assert_eq!(first, third);
+    }
+
+    #[test]
+    fn copy_frame_copies_whole_padded_rows() {
+        let image = StreamingImage::new(StreamingImageFormat::Rgba8);
+        let bytes: Vec<u8> = (0..40).collect();
+        image.copy_frame(frame_size(1, 2), 16, &bytes).unwrap();
+        assert_eq!(image.current().unwrap().bytes(), &bytes[..32]);
+    }
+
+    #[test]
+    fn invalid_frames_are_rejected_without_changing_the_image() {
+        let image = StreamingImage::new(StreamingImageFormat::Bgra8);
+        image.set_frame(frame_size(2, 2), 8, vec![0; 16]).unwrap();
+
+        assert!(image.set_frame(frame_size(0, 2), 8, vec![0; 16]).is_err());
+        assert!(image.set_frame(frame_size(2, 0), 8, vec![0; 16]).is_err());
+        assert!(image.set_frame(frame_size(2, 2), 4, vec![0; 16]).is_err());
+        assert!(image.set_frame(frame_size(2, 2), 10, vec![0; 20]).is_err());
+        assert!(image.set_frame(frame_size(2, 2), 8, vec![0; 15]).is_err());
+        assert!(image.copy_frame(frame_size(2, 2), 12, &[0; 20]).is_err());
+        assert!(
+            image
+                .copy_frame(frame_size(i32::MAX, i32::MAX), usize::MAX - 3, &[])
+                .is_err()
+        );
+
+        let current = image.current().unwrap();
+        assert_eq!(current.generation(), 1);
+        assert_eq!(current.size(), frame_size(2, 2));
+    }
+
+    #[test]
+    fn clear_drops_the_frame_and_later_frames_keep_counting() {
+        let image = StreamingImage::new(StreamingImageFormat::Bgra8);
+        let weak = image.downgrade();
+        assert!(!weak.has_frame());
+
+        image.set_frame(frame_size(1, 1), 4, vec![0; 4]).unwrap();
+        assert!(weak.has_frame());
+
+        image.clear();
+        assert!(image.current().is_none());
+        assert!(!weak.has_frame());
+
+        image.copy_frame(frame_size(1, 1), 4, &[0; 4]).unwrap();
+        assert_eq!(image.current().unwrap().generation(), 2);
+        assert!(weak.has_frame());
+
+        drop(image);
+        assert!(!weak.has_frame());
+    }
+}
