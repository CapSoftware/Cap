+/// The phase of a trackpad scroll or momentum gesture.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub enum ScrollPhase {
+    /// No active gesture phase (e.g. discrete mouse wheel).
+    #[default]
+    None,
+    /// The user has touched the trackpad and may begin scrolling.
+    MayBegin,
+    /// The scroll gesture has begun.
+    Began,
+    /// The scroll gesture is actively changing.
+    Changed,
+    /// The scroll gesture has ended.
+    Ended,
+    /// The scroll gesture was cancelled.
+    Cancelled,
+}
+
 /// A mouse wheel event from the platform.
 #[derive(Clone, Debug, Default)]
 pub struct ScrollWheelEvent {
@@ -522,6 +540,21 @@ pub struct ScrollWheelEvent {
 
     /// The phase of the touch event.
     pub touch_phase: TouchPhase,
+
+    /// The phase of the trackpad scroll gesture.
+    pub scroll_phase: ScrollPhase,
+
+    /// The phase of the momentum coasting gesture.
+    pub momentum_phase: ScrollPhase,
+}
+
+impl ScrollWheelEvent {
+    /// Returns true if this event originated from a precise trackpad gesture or momentum phase
+    /// rather than a discrete mouse wheel.
+    pub fn is_precise_trackpad_scroll(&self) -> bool {
+        matches!(self.delta, ScrollDelta::Pixels(_))
+            && (self.scroll_phase != ScrollPhase::None || self.momentum_phase != ScrollPhase::None)
+    }
 }
 
 impl Sealed for ScrollWheelEvent {}
diff --git a/crates/gpui/src/rubber_band.rs b/crates/gpui/src/rubber_band.rs
new file mode 100644
index 0000000..214aebe
--- /dev/null
+++ b/crates/gpui/src/rubber_band.rs
@@ -0,0 +1,251 @@
+use std::sync::RwLock;
+use std::time::Instant;
+
+use crate::{Pixels, Point, Size};
+
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct RubberBandConfig {
+    pub resistance: f32,
+    pub spring_stiffness: f32,
+    pub spring_damping: f32,
+    pub momentum_carry: f32,
+    pub max_overscroll_ratio: f32,
+    pub settle_epsilon: f32,
+}
+
+impl RubberBandConfig {
+    pub const DEFAULT: Self = Self {
+        resistance: 0.55,
+        spring_stiffness: 220.0,
+        spring_damping: 30.0,
+        momentum_carry: 0.35,
+        max_overscroll_ratio: 0.50,
+        settle_epsilon: 0.25,
+    };
+}
+
+impl Default for RubberBandConfig {
+    fn default() -> Self {
+        Self::DEFAULT
+    }
+}
+
+static RUBBER_BAND_CONFIG: RwLock<RubberBandConfig> = RwLock::new(RubberBandConfig::DEFAULT);
+
+pub fn rubber_band_config() -> RubberBandConfig {
+    *RUBBER_BAND_CONFIG
+        .read()
+        .unwrap_or_else(|poisoned| poisoned.into_inner())
+}
+
+pub fn set_rubber_band_config(config: RubberBandConfig) {
+    if let Ok(mut guard) = RUBBER_BAND_CONFIG.write() {
+        *guard = config;
+    }
+}
+
+pub fn rubber_band_offset(raw_overscroll: f32, dimension: f32, config: &RubberBandConfig) -> f32 {
+    if raw_overscroll == 0.0 {
+        return 0.0;
+    }
+    let dim = dimension.max(1.0);
+    let d = raw_overscroll.abs();
+    let c = config.resistance.clamp(0.01, 1.0);
+    let max_overscroll = dim * config.max_overscroll_ratio.clamp(0.05, 0.95);
+    let rubber = (d * c * dim) / (dim + c * d);
+    raw_overscroll.signum() * rubber.min(max_overscroll)
+}
+
+#[derive(Clone, Copy, Debug, Default)]
+pub struct RubberBandAxisState {
+    pub raw_overscroll: f32,
+    pub velocity: f32,
+    pub springing: bool,
+}
+
+impl RubberBandAxisState {
+    pub fn cancel_spring(&mut self) {
+        self.springing = false;
+        self.velocity = 0.0;
+    }
+
+    pub fn start_spring(&mut self) {
+        if self.raw_overscroll != 0.0 {
+            self.springing = true;
+        }
+    }
+
+    pub fn step_spring(&mut self, dt: f32, config: &RubberBandConfig) -> bool {
+        if !self.springing {
+            return false;
+        }
+        let dt = dt.clamp(0.0, 1.0 / 30.0);
+        let prev = self.raw_overscroll;
+        let accel =
+            -config.spring_stiffness * self.raw_overscroll - config.spring_damping * self.velocity;
+        self.velocity += accel * dt;
+        self.raw_overscroll += self.velocity * dt;
+
+        let crossed_zero =
+            (prev > 0.0 && self.raw_overscroll <= 0.0) || (prev < 0.0 && self.raw_overscroll >= 0.0);
+        if crossed_zero
+            || (self.raw_overscroll.abs() < config.settle_epsilon && self.velocity.abs() < 1.0)
+        {
+            self.raw_overscroll = 0.0;
+            self.velocity = 0.0;
+            self.springing = false;
+            false
+        } else {
+            true
+        }
+    }
+}
+
+#[derive(Clone, Debug, Default)]
+pub struct RubberBandScrollState {
+    pub x: RubberBandAxisState,
+    pub y: RubberBandAxisState,
+    pub last_frame: Option<Instant>,
+    pub scroll_max: Point<Pixels>,
+    pub bounds_size: Size<Pixels>,
+    pub momentum_bounced: bool,
+}
+
+impl RubberBandScrollState {
+    pub fn cancel_springs(&mut self) {
+        self.x.cancel_spring();
+        self.y.cancel_spring();
+        self.last_frame = None;
+        self.momentum_bounced = false;
+    }
+
+    pub fn start_springs(&mut self) -> bool {
+        self.x.start_spring();
+        self.y.start_spring();
+        if self.x.springing || self.y.springing {
+            self.last_frame = Some(Instant::now());
+            true
+        } else {
+            false
+        }
+    }
+
+    pub fn is_springing(&self) -> bool {
+        self.x.springing || self.y.springing
+    }
+}
+
+pub fn apply_scroll_delta(
+    axis: &mut RubberBandAxisState,
+    offset: &mut f32,
+    max_scroll: f32,
+    delta: f32,
+    dim: f32,
+    is_momentum: bool,
+    config: &RubberBandConfig,
+) {
+    if delta == 0.0 {
+        return;
+    }
+    let min = -max_scroll.max(0.0);
+    let max = 0.0;
+
+    if axis.raw_overscroll == 0.0 {
+        let next = *offset + delta;
+        if next > max {
+            let excess = next - max;
+            if is_momentum {
+                if config.momentum_carry <= 0.001 {
+                    *offset = max;
+                } else {
+                    axis.raw_overscroll = excess * config.momentum_carry;
+                    axis.velocity = (delta * 60.0 * config.momentum_carry).clamp(-2400.0, 2400.0);
+                    axis.springing = true;
+                    *offset = max + rubber_band_offset(axis.raw_overscroll, dim, config);
+                }
+            } else {
+                axis.raw_overscroll = excess;
+                *offset = max + rubber_band_offset(axis.raw_overscroll, dim, config);
+            }
+        } else if next < min {
+            let excess = next - min;
+            if is_momentum {
+                if config.momentum_carry <= 0.001 {
+                    *offset = min;
+                } else {
+                    axis.raw_overscroll = excess * config.momentum_carry;
+                    axis.velocity = (delta * 60.0 * config.momentum_carry).clamp(-2400.0, 2400.0);
+                    axis.springing = true;
+                    *offset = min + rubber_band_offset(axis.raw_overscroll, dim, config);
+                }
+            } else {
+                axis.raw_overscroll = excess;
+                *offset = min + rubber_band_offset(axis.raw_overscroll, dim, config);
+            }
+        } else {
+            *offset = next;
+        }
+    } else {
+        let was_positive = axis.raw_overscroll > 0.0;
+        let scaled_delta = if is_momentum && (delta > 0.0) == was_positive {
+            delta * config.momentum_carry
+        } else {
+            delta
+        };
+        let next_raw = axis.raw_overscroll + scaled_delta;
+        if next_raw == 0.0 || (next_raw > 0.0) != was_positive {
+            axis.raw_overscroll = 0.0;
+            let base = if was_positive { max } else { min };
+            *offset = (base + next_raw).clamp(min, max);
+        } else {
+            axis.raw_overscroll = next_raw;
+            let base = if was_positive { max } else { min };
+            *offset = base + rubber_band_offset(axis.raw_overscroll, dim, config);
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn resistance_is_monotonic_and_bounded() {
+        let config = RubberBandConfig::DEFAULT;
+        let dim = 600.0;
+        let a = rubber_band_offset(20.0, dim, &config);
+        let b = rubber_band_offset(100.0, dim, &config);
+        let c = rubber_band_offset(10_000.0, dim, &config);
+
+        assert!(a > 0.0 && a < 20.0);
+        assert!(b > a && b < 100.0);
+        assert!(c >= b);
+        assert!(c <= dim * config.max_overscroll_ratio + f32::EPSILON);
+    }
+
+    #[test]
+    fn spring_settles_to_zero() {
+        let config = RubberBandConfig::DEFAULT;
+        let mut axis = RubberBandAxisState {
+            raw_overscroll: 120.0,
+            velocity: 0.0,
+            springing: true,
+        };
+
+        let mut steps = 0;
+        while axis.step_spring(1.0 / 60.0, &config) {
+            steps += 1;
+            assert!(steps < 600, "spring did not settle within 10 seconds");
+        }
+
+        assert_eq!(axis.raw_overscroll, 0.0);
+        assert_eq!(axis.velocity, 0.0);
+        assert!(!axis.springing);
+    }
+
+    #[test]
+    fn zero_overscroll_returns_zero() {
+        let config = RubberBandConfig::DEFAULT;
+        assert_eq!(rubber_band_offset(0.0, 500.0, &config), 0.0);
+    }
+}
