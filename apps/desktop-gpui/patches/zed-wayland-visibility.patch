+    /// A window hidden before its first buffer stays configurable but never
+    /// draws, and its hide is acknowledged at once: there is nothing to unmap.
+    #[test]
+    fn a_never_mapped_window_is_withheld_and_acknowledged_immediately() {
+        assert!(VisibilityPhase::Withheld.can_acknowledge_configure());
+        assert!(!VisibilityPhase::Withheld.can_draw(true));
+
+        let mut visibility = RetainedVisibility::default();
+        let mut hidden = visibility.request(false);
+        visibility.phase = VisibilityPhase::Withheld;
+        visibility.complete();
+        assert_eq!(block_on(hidden).unwrap().unwrap(), (1, false));
+
+        let mut shown = visibility.request(true);
+        visibility.complete();
+        assert!(shown.try_recv().unwrap().is_none());
+    }
