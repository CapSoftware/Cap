+    /// The surface is unmapped and still waiting for the configure that the
+    /// protocol says must answer its initial commit. Destroying the toplevel and
+    /// creating a new one on the same surface (what GTK does on every hide)
+    /// gets a configure from every compositor.
+    fn recreate_role_if_unconfigured(&self, transition: u64) {
+        let mut state = self.state.borrow_mut();
+        if state.visibility.phase != VisibilityPhase::Configuring(transition)
+            || state.acknowledged_first_configure
+            || state.buffer_attached
+        {
+            return;
+        }
+        match &state.surface_state {
+            WaylandSurfaceState::Xdg(xdg) if xdg.dialog.is_none() => {
+                if let Some(decoration) = &xdg.decoration {
+                    decoration.destroy();
+                }
+                xdg.toplevel.destroy();
+                xdg.xdg_surface.destroy();
+            }
+            _ => return,
+        }
+        log::info!("no configure after remapping a window; replacing its toplevel role");
+        let xdg_surface =
+            state
+                .globals
+                .wm_base
+                .get_xdg_surface(&state.surface, &state.globals.qh, state.surface.id());
+        let toplevel = xdg_surface.get_toplevel(&state.globals.qh, state.surface.id());
+        let decoration = state.globals.decoration_manager.as_ref().map(|manager| {
+            manager.get_toplevel_decoration(&toplevel, &state.globals.qh, state.surface.id())
+        });
+        state.surface_state = WaylandSurfaceState::Xdg(WaylandXdgSurfaceState {
+            xdg_surface,
+            toplevel,
+            decoration,
+            dialog: None,
+        });
+        // The first remap attempt cached its size limits for the old role.
+        state.fixed_geometry_size = None;
+        state.apply_toplevel_state();
+        state.update_size_constraints();
+        state.surface.commit();
+    }
