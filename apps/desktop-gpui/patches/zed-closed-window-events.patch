 pub use prompts::*;
 
+/// A platform can still report focus, hover, input or a frame request for a
+/// window gpui has already removed while it closes. There is nothing left to
+/// update, so that one failure is not an error worth logging.
+trait LogUnlessClosed<T> {
+    fn log_unless_closed(self) -> Option<T>;
+}
+
+impl<T> LogUnlessClosed<T> for Result<T> {
+    #[track_caller]
+    fn log_unless_closed(self) -> Option<T> {
+        match self {
+            Ok(value) => Some(value),
+            Err(error) if error.to_string() == "window not found" => None,
+            Err(error) => Err::<T, _>(error).log_err(),
+        }
+    }
+}
+
 /// Default window size used when no explicit size is provided.
