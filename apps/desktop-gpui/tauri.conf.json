{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Cap",
	"mainBinaryName": "Cap",
	"identifier": "so.cap.desktop",
	"plugins": {
		"updater": {
			"endpoints": [
				"https://cdn.crabnebula.app/update/cap/cap/{{target}}/{{current_version}}"
			],
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUyOTAzOTdFNzJFQkRFOTMKUldTVDN1dHlmam1RNHFXb1VYTXlrQk1iMFFkcjN0YitqZlA5WnZNY0ZtQ1dvM1dxK211M3VIYUQK"
		},
		"deep-link": {
			"desktop": {
				"schemes": ["cap-desktop"]
			}
		}
	},
	"bundle": {
		"active": true,
		"createUpdaterArtifacts": true,
		"targets": "all",
		"category": "Video",
		"longDescription": "Cap is the open source alternative to Loom. Lightweight, powerful, and cross-platform. Record and share in seconds.",
		"externalBin": [
			"../desktop/src-tauri/binaries/cap-muxer",
			"../desktop/src-tauri/binaries/cap-cli"
		],
		"icon": [
			"../desktop/src-tauri/icons/32x32.png",
			"../desktop/src-tauri/icons/128x128.png",
			"../desktop/src-tauri/icons/128x128@2x.png",
			"../desktop/src-tauri/icons/macos/icon.icns",
			"../desktop/src-tauri/icons/icon.ico"
		],
		"resources": {
			"../desktop/src-tauri/assets/backgrounds/macOS/*": "assets/backgrounds/macOS/",
			"../desktop/src-tauri/assets/backgrounds/blue/*": "assets/backgrounds/blue/",
			"../desktop/src-tauri/assets/backgrounds/cities/*": "assets/backgrounds/cities/",
			"../desktop/src-tauri/assets/backgrounds/dark/*": "assets/backgrounds/dark/",
			"../desktop/src-tauri/assets/backgrounds/orange/*": "assets/backgrounds/orange/",
			"../desktop/src-tauri/assets/backgrounds/purple/*": "assets/backgrounds/purple/",
			"../desktop/src/assets/music/*.mp3": "assets/music/"
		},
		"fileAssociations": [
			{
				"ext": ["cap"],
				"name": "Cap Project",
				"mimeType": "application/x-cap-project",
				"role": "Editor"
			}
		],
		"macOS": {
			"minimumSystemVersion": "12.3",
			"entitlements": "../desktop/src-tauri/Entitlements.plist",
			"frameworks": ["../../target/native-deps/Spacedrive.framework"],
			"dmg": {
				"background": "../desktop/src-tauri/assets/dmg-background.png",
				"appPosition": {
					"x": 180,
					"y": 140
				},
				"applicationFolderPosition": {
					"x": 480,
					"y": 140
				}
			}
		},
		"windows": {
			"nsis": {
				"headerImage": "../desktop/src-tauri/assets/nsis-header.bmp",
				"sidebarImage": "../desktop/src-tauri/assets/nsis-sidebar.bmp",
				"installerIcon": "../desktop/src-tauri/icons/icon.ico",
				"installerHooks": "packaging/windows/installer-hooks.nsh"
			},
			"webviewInstallMode": {
				"type": "skip"
			}
		},
		"linux": {
			"deb": {
				"depends": [
					"libva2",
					"libva-drm2",
					"pulseaudio-utils",
					"libpipewire-0.3-0",
					"libasound2t64 | libasound2",
					"libxkbcommon0",
					"libxkbcommon-x11-0",
					"libx11-6",
					"libssl3t64 | libssl3",
					"libwayland-client0",
					"libwayland-egl1",
					"libegl1",
					"libvulkan1"
				]
			}
		}
	}
}
