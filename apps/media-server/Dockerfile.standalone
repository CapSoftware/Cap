FROM oven/bun:1.4.4

RUN apt-get update \
	&& apt-get install -y --no-install-recommends ffmpeg \
	&& rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json bun.lock ./
RUN bun install --frozen-lockfile --production

COPY bunfig.toml ./bunfig.toml
COPY src ./src
COPY capcodec.md ./capcodec.md

ENV PORT=3456
# Self-hosted storage usually sits on a private network next to this container.
ENV MEDIA_SERVER_INTERNAL_MEDIA_HOSTS=*
EXPOSE 3456

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
	CMD ["bun", "-e", "fetch(`http://127.0.0.1:${process.env.PORT || 3456}/health`).then((response) => process.exit(response.ok ? 0 : 1)).catch(() => process.exit(1))"]

CMD ["bun", "run", "src/index.ts"]
