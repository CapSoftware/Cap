{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "cap",
  "title": "Cap",
  "description": "Start and stop screen recordings with Cap and open your dashboard.",
  "icon": "icon.png",
  "author": "CapSoftware",
  "categories": [
    "Productivity",
    "Media"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "start-recording",
      "title": "Start Recording",
      "description": "Start recording your screen with Cap",
      "mode": "no-view"
    },
    {
      "name": "stop-recording",
      "title": "Stop Recording",
      "description": "Stop current recording in Cap",
      "mode": "no-view"
    },
    {
      "name": "open-dashboard",
      "title": "Open Dashboard",
      "description": "Open your Cap web dashboard",
      "mode": "no-view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.88.0"
  },
  "devDependencies": {
    "@types/node": "20.8.10",
    "@types/react": "18.2.27",
    "prettier": "^3.3.3",
    "typescript": "^5.4.5"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop"
  }
}
