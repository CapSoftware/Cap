{
	"$schema": "../../manifest.schema.json",
	"apiVersion": 1,
	"id": "studio-captions",
	"name": "Studio Captions",
	"version": "1.0.0",
	"description": "Five caption styles for tutorials, social clips and talks, from quiet subtitles to bold highlights.",
	"author": { "name": "Cap", "github": "CapSoftware" },
	"license": "MIT",
	"categories": ["captions"],
	"keywords": ["subtitles", "karaoke", "social"],
	"captionStyles": [
		{
			"id": "headline",
			"name": "Headline",
			"description": "Big, bold and uppercase with a yellow highlight",
			"fontWeight": 700,
			"size": 64,
			"color": "#FFFFFF",
			"backgroundColor": "#000000",
			"backgroundOpacity": 0,
			"outline": true,
			"outlineColor": "#000000",
			"highlightColor": "#FFD43B",
			"activeWordHighlight": true,
			"highlightStyle": "color",
			"animation": "pop",
			"uppercase": true,
			"fadeDuration": 0.12
		},
		{
			"id": "whisper",
			"name": "Whisper",
			"description": "Small, light subtitles that stay out of the way",
			"fontWeight": 500,
			"size": 36,
			"color": "#F5F5F5",
			"backgroundColor": "#000000",
			"backgroundOpacity": 45,
			"outline": false,
			"outlineColor": "#000000",
			"highlightColor": "#FFFFFF",
			"activeWordHighlight": false,
			"highlightStyle": "color",
			"animation": "none",
			"uppercase": false,
			"fadeDuration": 0.25
		},
		{
			"id": "neon",
			"name": "Neon",
			"description": "Bright pink pill on every spoken word",
			"fontWeight": 700,
			"size": 54,
			"color": "#FFFFFF",
			"backgroundColor": "#0B0B0F",
			"backgroundOpacity": 70,
			"outline": false,
			"outlineColor": "#000000",
			"highlightColor": "#FF2E93",
			"activeWordHighlight": true,
			"highlightStyle": "pill",
			"animation": "bounce",
			"uppercase": false,
			"fadeDuration": 0.15
		},
		{
			"id": "broadcast",
			"name": "Broadcast",
			"description": "Solid bar captions like the evening news",
			"fontWeight": 500,
			"size": 44,
			"color": "#FFFFFF",
			"backgroundColor": "#1A1A1A",
			"backgroundOpacity": 92,
			"outline": false,
			"outlineColor": "#000000",
			"highlightColor": "#FFFFFF",
			"activeWordHighlight": false,
			"highlightStyle": "color",
			"animation": "none",
			"uppercase": false,
			"fadeDuration": 0.2
		},
		{
			"id": "mint",
			"name": "Mint",
			"description": "Fresh green highlight with a gentle bounce",
			"fontWeight": 700,
			"size": 50,
			"color": "#FFFFFF",
			"backgroundColor": "#000000",
			"backgroundOpacity": 0,
			"outline": true,
			"outlineColor": "#0B3D2E",
			"highlightColor": "#5CF2B4",
			"activeWordHighlight": true,
			"highlightStyle": "color",
			"animation": "bounce",
			"uppercase": false,
			"fadeDuration": 0.14
		}
	]
}
