#!/usr/bin/env node
// ux-walk: record a narrated walkthrough of a web app, in chapters, and turn each chapter into a
// timeline an agent can read (speech, page changes, clicks, writes, errors, screenshots).
import { execFileSync, spawnSync } from 'node:child_process';
import fs from 'node:fs';
import path from 'node:path';
import readline from 'node:readline/promises';
import { fileURLToPath } from 'node:url';

const ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
const { loadConfig, CONFIG_DIR, CONFIG_FILE } = await import(path.join(ROOT, 'src/config.mjs'));

const HELP = `ux-walk: record a narrated walkthrough in chapters; get a timeline per chapter.

  ux-walk [topic words] [url]      record (url or /path; default url from config); chapters split while recording
  ux-walk start [topic words] [url]
                                   one entry for internal instructions (default); add --capture cap for
                                   shareable video, or --attach-cap ID to log an existing CLI recording
  ux-walk call [topic words] [url] [--app zoom|facetime|meet|slack|teams|arc|safari] [--conversation]
                                   a walk on a call: the ux-walk Chrome window opens at the start page for
                                   you to share in the call, recorded with every click, console message and
                                   request; your mic and the call's sound go on separate tracks, transcribed
                                   apart so you and they are named by track (default call app: the one using
                                   the microphone). --conversation records the call app's own window instead
  ux-walk video [topic words] [url] [--display N]
                                   a walk filmed as a video (Loom-style): the ux-walk browser with its full log at
                                   30 fps; the menu bar app's camera bubble is drawn over it (--bubble-window id);
                                   --display N films the whole screen instead of the browser window
  ux-walk import <file|project.cap> [topic words] [--ask "..."] [--start <iso|epoch-ms>] [--no-brief] [--diatribe]
                                   a video made elsewhere (an iPhone screen recording with the mic on; .mp4 .mov
                                   .m4v) or a voice memo (.m4a .mp3 .wav .aac) becomes a recording: same folder,
                                   transcript, shots, timeline and brief, with no click log. Start time: --start,
                                   else the file's own dates (see README). --diatribe: a ramble; the brief is
                                   organized notes with action items (owner and due when said)
  ux-walk process <dir>...         (re)process chapters or old recordings: audio, shots, transcript, timeline
  ux-walk process --stale [dir]    rebuild timelines made by an older ux-walk or before a glossary change (--dry-run lists)
  ux-walk timeline <dir> [--short] [--stdout]
                                   rebuild the timeline only (no upload); --stdout prints it
  ux-walk report <dir>           deterministic HTML report from saved findings, checkpoints and timings;
                                 a parent report.json combines existing interrupted/continuation sessions
  ux-walk cap doctor|targets      Cap Desktop readiness or exact target/device IDs (JSON)
  ux-walk cap sessions            active/recent detached Cap recordings (JSON)
  ux-walk cap compatibility       check the installed Cap contract without recording or updating
  ux-walk cap update              update official Cap, then check compatibility; refuses live sessions
  ux-walk cap reconcile <walk>    after Cap stops, copy/render attached media into the saved log
  ux-walk cap edit <project.cap>  open an editable copy in Cap; preserve the source project
  ux-walk brief <dir>              Claude writes brief.md + items.json: notes, asks, decisions, bugs (ids C1-01...),
                                   errors, questions for you (needs the claude CLI)
  ux-walk link <folder> <id|key> <ref> [note] [--add]
                                   record what an item became (a bead, a PR, "dropped") in ledger.json;
                                   replaces the item's refs (--add: keep them and add this one)
  ux-walk items [folder] [--json]  the items with your edits (edits.json) applied, deleted ones flagged
  ux-walk items <folder> --apply <file|->
                                   replace edits.json with this JSON (validated); prints the merged items
  ux-walk status [folder] [--all]  items with no ref yet, and open questions (default: the latest recording;
                                   --all: every recording from the last 14 days)
  ux-walk search <terms> [-n 40]   brief items and speech across every recording, newest first
  ux-walk speakers <dir>           name the voices in each chapter, then rebuild the timelines
  ux-walk frame <chapter> <mm:ss>...
                                   save the video frame at those times to shots/ and print the paths
  ux-walk glossary [new <name>]    list glossaries, or create one
  ux-walk glossary suggestions <session> [--json]   terms this recording's transcript got wrong (pending/accepted/rejected)
  ux-walk glossary accept <session> <term...|--all> [--to <glossary>] [--json]   add them to the project's glossary
  ux-walk glossary reject <session> <term...> [--json]
  ux-walk projects [--json]        list projects (glossary, tracker + target, source folder, notes); --project <id>
                                   on record/import/process puts a recording in one (config "project": the default)
  ux-walk projects show <id> | save <file|->
                                   print one project, or save one (validated JSON, see README)
  ux-walk trackers [--json]        the issue tracker plugins (beads, github, linear) and whether each is ready
  ux-walk trackers targets <id> [--json]
                                   where that tracker can file: folders, owner/repo, Linear teams and projects
  ux-walk file <folder> [--keys k1,k2 | --all] [--types action,bug] [--tracker id --target t] [--dry-run] [--json]
                                   file items as issues in the recording's project tracker and link each in the
                                   ledger (default: a diatribe's actions, a walk's bugs and asks; linked ones skipped)
  ux-walk handoff <folder> [--json]
                                   the agent line and context for a recording (names its project's tracker)
  ux-walk windows                  list windows that can be recorded
  ux-walk setup                    pick the transcriber and store its key, check permissions, write a config file
  ux-walk app                      open the menu bar app (built by install.sh)
  ux-walk agent <folder>           open a Claude Code session (opus) in a new cmux workspace with the walk's prompt
                                   (config "agent": "cmux" does this when every walk ends)
  ux-walk help

While recording, type:
${'  + <Name>   someone joined: a speaker from now on\n  n [name]   start the next chapter (the one just finished is processed in the background)\n  m <note>   drop a marker into the timeline\n  p          pause / resume\n  s          status\n  q          stop; then say what agents should do with the walk (copied as a /ux-walk prompt; skips after 15 s)'}
From any app, the terminal too: Option+Shift+N next chapter, Option+Shift+M marker, Option+Shift+P
pause/resume (Ctrl+Option+N / M / P also work); the browser shows each one as a toast.
In the browser, hold Option+Shift: click to pin a note, drag to draw a box (drag the box to move it, a corner
to resize it, while its note is open). Without Option+Shift every click and key goes to the app.

Recording options:
  --app <name>       record that app's window instead of the ux-walk browser (with --no-browser: no click log)
  --no-browser       do not open Chrome (use with --app or --window-id); passive recording only
  --window-id <id>   record exactly this existing window (ux-walk windows lists IDs)
  --title <text>     with --app, require this window title substring; never fall back
  --evidence-only    skip transcription, processing, questions, clipboard and agent launch
  --capture screen   whole screen through ffmpeg instead of one window
  --capture cap      Cap Studio whole-screen capture: --no-browser and --screen-id required
  --attach-cap <id>  log an existing detached Cap session; never stop it or change its devices
  --screen-id <id>   Cap display ID (not a display index); ux-walk cap targets lists IDs
  --camera <id>      Cap camera device ID; kept as a separate editable track
  --system-audio     Cap only: record all system sound (off by default)
  --mic <name>       native: name substring/default mic; Cap: exact device name, off when unset
  --no-mic           video only
  --no-trace         skip the Playwright trace
  --speakers A,B     who is talking, you first (otherwise you are asked)
  --mic-people A,B   who is at this Mac's microphone, you first (the speakers screen; names voices by track)
  --call-people C,D  who is on the call
  --call-app <id>    the call's sound: auto, zoom, facetime, meet, slack, teams, arc, safari, system (all the Mac
                     plays) or none (mic only)
  --glossary a,b     add named glossaries (~/.config/ux-walk/glossaries/<name>.txt)
  --brief            write a brief per chapter as it finishes (config "brief": true does the same)
  --fps <n>          window capture frame rate (default 15)
  --script <file>    drive the page from a module (demos, testing): default export ({ page, cmd, say, sleep })

Process options:
  --speakers A,B     rename speakers   --retranscribe   fetch the transcript again
  --reshoot          grab screenshots again   --glossary a,b   use these glossaries   --brief   also write the brief
  --resection        find the sections again

A <folder> is a full path, a recording's folder name, or a unique end of one ("romerosojan").

Output: <outDir>/<date>-<topic>/NN-<chapter>/ with video.mp4, timeline.md, timeline-short.md,
shots/, transcript.srt, trace.zip; index.md lists the chapters. Config: ${CONFIG_FILE}`;

function parse(argv) {
  const pos = [], flags = {};
  const bool = new Set(['all', 'no-browser', 'no-mic', 'no-trace', 'short', 'stdout', 'retranscribe', 'reshoot', 'resection', 'quiet', 'help', 'h', 'brief', 'no-brief', 'stale', 'dry-run', 'add', 'ipc', 'conversation', 'evidence-only', 'system-audio', 'json', 'no-open', 'diatribe']);
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a.startsWith('--')) {
      const [k, v] = a.slice(2).split('=', 2);
      if (bool.has(k)) flags[k] = true;
      else flags[k] = v ?? argv[++i];
    } else if (a === '-h') flags.help = true;
    else if (a === '-n') flags.n = argv[++i];
    else pos.push(a);
  }
  return { pos, flags };
}

const { pos, flags } = parse(process.argv.slice(2));
const commands = new Set(['start', 'record', 'import', 'call', 'video', 'process', 'timeline', 'brief', 'link', 'items', 'status', 'search', 'speakers', 'frame', 'glossary', 'windows', 'setup', 'app', 'agent', 'report', 'cap', 'help', 'projects', 'trackers', 'file', 'handoff']);
const selected = commands.has(pos[0]) ? pos.shift() : 'record';
const cmd = selected === 'start' ? 'record' : selected;

if (flags.help || flags.h || cmd === 'help') { console.log(HELP); process.exit(0); }

const overrides = {};
if (flags.capture) overrides.capture = flags.capture;
if (flags['attach-cap']) { overrides.capture = 'cap'; overrides.attachCap = flags['attach-cap']; }
if (flags['screen-id']) overrides.screenId = flags['screen-id'];
if (flags.camera) overrides.camera = flags.camera;
if (flags['system-audio']) overrides.systemAudio = true;
if (flags.mic) overrides.mic = flags.mic;
if (flags['no-mic']) overrides.noMic = true;
if (flags['no-trace']) overrides.trace = false;
if (flags.fps) overrides.fps = Number(flags.fps);
if (flags.speakers) overrides.speakers = flags.speakers;
if (flags.out) overrides.outDir = flags.out;
if (flags.brief) overrides.brief = true;
if (flags['no-brief']) overrides.brief = false;
// The recording's own switch: written to session.json when --brief or --no-brief is given.
const briefFlag = flags.brief ? true : flags['no-brief'] ? false : undefined;
if (flags['evidence-only']) Object.assign(overrides, { evidenceOnly: true, transcriber: 'none', brief: false, sections: false, agent: null, callAudio: false, noMic: true, askSpeakers: false, trace: false });
// The speakers screen: who is at this Mac's mic and who is on the call; which call app to record (none = mic only).
const people = (v) => String(v || '').split(',').map((x) => x.trim()).filter(Boolean);
const sources = flags['mic-people'] || flags['call-people'] ? { mic: people(flags['mic-people']), call: people(flags['call-people']) } : null;
if (sources) overrides.speakers = [...sources.mic, ...sources.call].join(',');
if (flags['call-app'] === 'none') overrides.callAudio = false;
else if (flags['call-app']) overrides.callApp = flags['call-app'];
let cfg = loadConfig(overrides);

// A path, or a recording's folder name (or a unique end of one) in outDir.
const dirArg = async (d) => {
  if (!d) { console.error('give a recording or chapter folder'); process.exit(2); }
  const p = path.resolve(d);
  if (fs.existsSync(p)) return p;
  const { resolveSession } = await import(path.join(ROOT, 'src/ledger.mjs'));
  try { return resolveSession(d, cfg.outDir); } catch (e) { console.error(`no such folder: ${p} (${e.message})`); process.exit(2); }
};

// A session folder means "every chapter in it".
const chapterDirs = (p) => {
  if (fs.existsSync(path.join(p, 'session.json'))) {
    const s = JSON.parse(fs.readFileSync(path.join(p, 'session.json'), 'utf8'));
    return s.chapters.map((c) => path.join(p, c.dir));
  }
  return [p];
};

// Projects (src/projects.mjs): a new recording takes --project <id> or config "project", and that project's
// glossary, source folder, notes and url; an existing one runs with the project named in its session.json
// (process --project <id> moves it into that project first).
const projects = await import(path.join(ROOT, 'src/projects.mjs'));
const sessionOf = (d) => (fs.existsSync(path.join(d, 'session.json')) ? d : path.dirname(d));
const cfgFor = (d) => projects.withProject(cfg, projects.sessionProject(sessionOf(d), cfg));
if (['record', 'video', 'call', 'import'].includes(cmd)) {
  try { cfg = projects.withProject(cfg, projects.projectFor(cfg, flags.project)); } catch (e) { console.error(e.message); process.exit(2); }
} else if (cmd === 'process' && flags.project) {
  let p;
  try { p = projects.readProject(cfg, flags.project); } catch (e) { console.error(e.message); process.exit(2); }
  if (!p) { console.error(`no project "${flags.project}" in ${projects.projectsDir(cfg)} (ux-walk projects lists them)`); process.exit(2); }
  for (const d of pos.length ? pos : [undefined]) projects.assignProject(sessionOf(await dirArg(d)), p);
}

if (cmd === 'cap') {
  const { CapClient, prepareCapEdit } = await import(path.join(ROOT, 'src/cap.mjs'));
  const [action, project] = pos;
  try {
    if (['doctor', 'targets'].includes(action)) console.log(JSON.stringify(await new CapClient().json([action]), null, 2));
    else if (action === 'sessions') console.log(JSON.stringify(await new CapClient().json(['record', 'status']), null, 2));
    else if (['compatibility', 'update'].includes(action)) {
      const { checkCapCompatibility, updateCap } = await import(path.join(ROOT, 'src/cap-updates.mjs'));
      const result = await (action === 'update' ? updateCap() : checkCapCompatibility());
      console.log(JSON.stringify(result, null, 2));
      if (!result.ok) process.exitCode = 1;
    } else if (action === 'reconcile' && project) {
      const dir = await dirArg(project);
      const { reconcileCapSession } = await import(path.join(ROOT, 'src/cap-session.mjs'));
      const result = await reconcileCapSession(dir);
      if (!result.pending) {
        const sessionFile = path.join(dir, 'session.json'), s = JSON.parse(fs.readFileSync(sessionFile, 'utf8'));
        for (const row of s.chapters.filter((c) => c.status === 'waiting for media')) {
          const span = result.spans.find((p) => p.file === `${row.dir}/video.mp4`);
          row.status = span?.empty ? 'empty' : fs.existsSync(path.join(dir, row.dir, 'video.mp4')) ? (s.evidenceOnly ? 'evidence' : 'recorded') : 'waiting for media';
        }
        s.cap.pendingMedia = false;
        if (s.coverage) s.coverage.video = 'Materialized from completed Cap media; source alignment remains approximate.';
        fs.writeFileSync(sessionFile, JSON.stringify(s, null, 2) + '\n');
        const { writeReport } = await import(path.join(ROOT, 'src/report.mjs')); result.report = writeReport(dir);
      }
      console.log(JSON.stringify(result, null, 2));
    }
    else if (action === 'edit' && project) {
      const file = prepareCapEdit(path.resolve(project));
      if (!flags['no-open']) {
        const binary = new CapClient().binary;
        const app = binary.match(/^(.*\.app)\/Contents\/MacOS\/cap-cli$/)?.[1] || 'Cap';
        const r = spawnSync('open', ['-a', app, file], { stdio: 'inherit' });
        if (r.status !== 0) throw new Error('Could not open Cap Desktop');
      }
      console.log(JSON.stringify({ project: file, source: path.resolve(project), opened: !flags['no-open'] }, null, 2));
    } else throw new Error('usage: ux-walk cap doctor|targets|sessions|compatibility|update|reconcile <walk>|edit <project.cap> [--no-open]');
  } catch (e) { console.error(JSON.stringify({ ok: false, error: e.message })); process.exit(1); }
} else if (cmd === 'record') {
  if (flags['attach-cap'] && (flags.camera || flags.mic || flags['system-audio'])) { console.error('Attaching cannot change devices; omit --camera, --mic and --system-audio'); process.exit(2); }
  if (flags['no-browser'] && !flags.app && !flags['window-id'] && !(cfg.capture === 'cap' && cfg.screenId)) { console.error('--no-browser needs --app <name>, --window-id <id>, or a Cap --screen-id'); process.exit(2); }
  // --ipc: the menu bar app drives the walk; stdout is JSON lines only.
  if (flags.ipc) (await import(path.join(ROOT, 'src/ipc.mjs'))).routeConsole();
  const { record } = await import(path.join(ROOT, 'src/record.mjs'));
  // Every word is the topic; a URL-looking word (http..., host.tld..., /path) is the start page.
  const isUrl = (w) => /^(https?:\/\/|\/|localhost)|^[\w-]+(\.[\w-]+)*\.[a-z]{2,}(:\d+)?(\/|$)/i.test(w);
  const urlArg = pos.find(isUrl);
  const startUrl = !urlArg ? cfg.url : urlArg.startsWith('/') ? new URL(urlArg, cfg.url).href : /^https?:/.test(urlArg) ? urlArg : `https://${urlArg}`;
  try {
    await record(cfg, { topic: pos.filter((w) => w !== urlArg).join(' ') || 'walk', url: startUrl, app: flags.app, title: flags.title, windowId: flags['window-id'], noBrowser: !!flags['no-browser'], glossary: flags.glossary, script: flags.script, ipc: !!flags.ipc, sources, brief: briefFlag, bubbleWindow: flags['bubble-window'] });
  } catch (e) {
    if (!flags.ipc) throw e;
    (await import(path.join(ROOT, 'src/ipc.mjs'))).emit({ ev: 'error', message: e.message });
    process.exit(1);
  }
} else if (cmd === 'video') {
  // A product video: a walk (the ux-walk browser with its click, console and network log) at 30 fps, with the menu
  // bar app's camera bubble drawn over the browser window; --display N films the whole screen instead.
  if (flags.ipc) (await import(path.join(ROOT, 'src/ipc.mjs'))).routeConsole();
  const { record } = await import(path.join(ROOT, 'src/record.mjs'));
  const isUrl = (w) => /^(https?:\/\/|\/|localhost)|^[\w-]+(\.[\w-]+)*\.[a-z]{2,}(:\d+)?(\/|$)/i.test(w);
  const urlArg = pos.find(isUrl);
  const startUrl = !urlArg ? cfg.url : urlArg.startsWith('/') ? new URL(urlArg, cfg.url).href : /^https?:/.test(urlArg) ? urlArg : `https://${urlArg}`;
  try {
    await record({ ...cfg, fps: flags.fps ? Number(flags.fps) : 30 }, { topic: pos.filter((w) => w !== urlArg).join(' ') || 'video', url: startUrl, kind: 'video',
      display: flags.display != null ? Number(flags.display) : undefined, bubbleWindow: flags['bubble-window'], glossary: flags.glossary, ipc: !!flags.ipc, sources, brief: briefFlag });
  } catch (e) {
    if (!flags.ipc) throw e;
    (await import(path.join(ROOT, 'src/ipc.mjs'))).emit({ ev: 'error', message: e.message });
    process.exit(1);
  }
} else if (cmd === 'call') {
  // A walk on a call: the ux-walk window you share, your mic and the call's own sound on separate tracks.
  const { detectCalls } = await import(path.join(ROOT, 'src/capture.mjs'));
  const calls = detectCalls();
  const want = flags.app && String(flags.app).toLowerCase();
  const c = want ? calls.find((x) => x.id === want) || { id: want, ...{ zoom: { window: 'zoom.us' }, facetime: { window: 'FaceTime' }, meet: { window: 'Google Chrome', title: 'Meet' }, slack: { window: 'Slack' }, teams: { window: 'Microsoft Teams' }, arc: { window: 'Arc' }, safari: { window: 'Safari' } }[want] }
    : calls.find((x) => x.active);
  const fail = (msg) => {
    if (flags.ipc) (async () => { (await import(path.join(ROOT, 'src/ipc.mjs'))).emit({ ev: 'error', message: msg }); process.exit(2); })();
    else { console.error(msg); process.exit(2); }
  };
  if (!c?.window) fail(want ? `unknown call app "${want}" (zoom, facetime, meet, slack, teams, arc, safari)`
    : `No call found: no call app is using the microphone${calls.length ? ` (running: ${calls.map((x) => x.name).join(', ')})` : ''}. Join the call first, or name the app: ux-walk call <topic> --app zoom|facetime|meet|slack|teams`);
  else {
    if (flags.ipc) (await import(path.join(ROOT, 'src/ipc.mjs'))).routeConsole();
    console.log(`Recording the ${c.name || c.id} call.`);
    const { record } = await import(path.join(ROOT, 'src/record.mjs'));
    try {
      // Default: the ux-walk Chrome window opens at the start page for you to share in the call, and is recorded with
      // every click, console message and request; the mic and the call's sound go on their own tracks.
      // --conversation records the call app's own window instead (a call with nothing to show).
      if (flags.conversation) {
        await record(cfg, { topic: pos.join(' ') || 'call', url: null, app: c.window, title: c.title || undefined, callApp: c.id, kind: 'call', noBrowser: true, glossary: flags.glossary, ipc: !!flags.ipc, sources, brief: briefFlag });
      } else {
        const isUrl = (w) => /^(https?:\/\/|\/|localhost)|^[\w-]+(\.[\w-]+)*\.[a-z]{2,}(:\d+)?(\/|$)/i.test(w);
        const urlArg = pos.find(isUrl);
        const startUrl = !urlArg ? cfg.url : urlArg.startsWith('/') ? new URL(urlArg, cfg.url).href : /^https?:/.test(urlArg) ? urlArg : `https://${urlArg}`;
        await record(cfg, { topic: pos.filter((w) => w !== urlArg).join(' ') || 'call', url: startUrl, callApp: c.id, kind: 'call', glossary: flags.glossary, ipc: !!flags.ipc, sources, brief: briefFlag, bubbleWindow: flags['bubble-window'] });
      }
    } catch (e) {
      if (!flags.ipc) throw e;
      (await import(path.join(ROOT, 'src/ipc.mjs'))).emit({ ev: 'error', message: e.message });
      process.exit(1);
    }
  }
} else if (cmd === 'import') {
  // A video (or voice memo) made outside ux-walk becomes a one-chapter recording, processed and briefed.
  const [file, ...words] = pos;
  if (!file) { console.error('usage: ux-walk import <video> [topic words] [--ask "..."] [--start <iso|epoch-ms>] [--no-brief] [--diatribe]'); process.exit(2); }
  const { importRecording } = await import(path.join(ROOT, 'src/import.mjs'));
  const { handoffLine } = await import(path.join(ROOT, 'src/naming.mjs'));
  let r;
  try {
    r = await importRecording(path.resolve(file), cfg, { topic: words.join(' '), ask: flags.ask, start: flags.start, brief: briefFlag, glossary: flags.glossary, kind: flags.diatribe ? 'diatribe' : 'import' });
  } catch (e) { console.error(e.message); process.exit(1); }
  const line = handoffLine(r.dir, r.session.ask, { kind: r.session.kind, project: projects.sessionProject(r.dir, cfg) });
  const copied = !cfg.evidenceOnly && !process.env.UXW_NO_COPY && spawnSync('pbcopy', { input: line }).status === 0;
  console.log(`Folder: ${r.dir}`);
  console.log(cfg.evidenceOnly ? `Report: ${path.join(r.dir, 'report.html')}` : r.brief ? `Brief: ${r.brief}` : `No brief${r.summary?.transcriptError ? ' (no transcript)' : flags['no-brief'] ? ' (--no-brief)' : ''}; timeline: ${path.join(r.chapterDir, 'timeline-short.md')}`);
  console.log(`${copied ? 'Copied to the clipboard' : 'Paste into Claude Code'}: ${line}`);
  process.exit(r.summary?.transcriptError ? 3 : 0);
} else if (cmd === 'agent') {
  const dir = await dirArg(pos[0]);
  const { handoffLine, openInCmux } = await import(path.join(ROOT, 'src/record.mjs'));
  const s = JSON.parse(fs.readFileSync(path.join(dir, 'session.json'), 'utf8'));
  const line = handoffLine(dir, pos.slice(1).join(' ') || s.ask, { kind: s.kind, project: projects.sessionProject(dir, cfg) });
  const why = openInCmux(dir, line, cfgFor(dir), s.topic || path.basename(dir));
  if (why) { console.error(`Could not open the agent in cmux: ${why}`); process.exit(1); }
  console.log(`Opened a Claude Code session in cmux: ${line}`);
} else if (cmd === 'process' && flags.stale) {
  // Chapters built by an older ux-walk or before a glossary change: rebuild their timelines (no new transcript).
  const { processChapter, staleChapters } = await import(path.join(ROOT, 'src/process.mjs'));
  const list = staleChapters(pos[0] ? await dirArg(pos[0]) : cfg.outDir, cfg);
  if (!list.length) console.log('Nothing stale.');
  for (const { dir, why } of list) {
    console.log(`${dir}: ${why}`);
    if (!flags['dry-run']) await processChapter(dir, cfgFor(dir), { quiet: true, brief: !!flags.brief }).catch((e) => console.error(`${dir}: ${e.message}`));
  }
} else if (cmd === 'process') {
  const { processChapter } = await import(path.join(ROOT, 'src/process.mjs'));
  const force = [...(flags.retranscribe ? ['transcript.srt'] : []), ...(flags.reshoot ? ['shots'] : []), ...(flags.resection ? ['sections.json'] : [])];
  let failed = 0, untranscribed = 0;
  for (const p of pos.length ? pos : [undefined]) {
    for (const d of chapterDirs(await dirArg(p))) {
      const sum = await processChapter(d, cfgFor(d), { force, speakers: flags.speakers, glossary: flags.glossary, brief: flags.brief ? true : flags['no-brief'] ? false : undefined, quiet: !!flags.quiet }).catch((e) => { failed++; console.error(`${d}: ${e.message}`); });
      if (sum?.transcriptError) { untranscribed++; console.error(`${d}: no transcript: ${sum.transcriptError}`); }
    }
  }
  // 3: every timeline was written, some without speech (the recorder shows "no transcript").
  process.exit(failed ? 1 : untranscribed ? 3 : 0);
} else if (cmd === 'timeline') {
  const { processChapter } = await import(path.join(ROOT, 'src/process.mjs'));
  for (const d of chapterDirs(await dirArg(pos[0]))) {
    await processChapter(d, { ...cfg, transcriber: 'none', brief: false, sections: 'cached' }, { speakers: flags.speakers, brief: false, log: flags.stdout ? () => {} : console.log, quiet: !!flags.stdout });
    if (flags.stdout) process.stdout.write(fs.readFileSync(path.join(d, flags.short ? 'timeline-short.md' : 'timeline.md'), 'utf8'));
  }
} else if (cmd === 'report') {
  const { writeReport } = await import(path.join(ROOT, 'src/report.mjs'));
  console.log(writeReport(await dirArg(pos[0])));
} else if (cmd === 'brief') {
  const { runBrief } = await import(path.join(ROOT, 'src/brief.mjs'));
  for (const d of chapterDirs(await dirArg(pos[0]))) {
    console.log(`writing brief for ${path.basename(d)}...`);
    console.log(await runBrief(d, cfgFor(d), { log: console.log }).catch((e) => `failed: ${e.message}`));
  }
} else if (cmd === 'link') {
  const { link, resolveSession } = await import(path.join(ROOT, 'src/ledger.mjs'));
  const [folder, id, ref, ...note] = pos;
  if (!folder || !id || !ref) { console.error('usage: ux-walk link <folder> <item-id|key> <ref> [note] [--add]   e.g. ux-walk link romerosojan C1-04 oncall-abc12'); process.exit(2); }
  try {
    const s = resolveSession(folder, cfg.outDir);
    const refs = link(s, id, ref, note.join(' '), { add: !!flags.add });
    console.log(`${path.basename(s)} ${/^c\d+-q?\d+$/i.test(id) ? id.toUpperCase() : id}: ${refs.map((r) => r.ref).join(', ')}`);
  } catch (e) { console.error(e.message); process.exit(1); }
} else if (cmd === 'items') {
  // What the desktop editor reads (--json) and saves (--apply). 0 ok; 1 bad input or IO (a JSON error on stderr with --json).
  const { mergedItems, resolveSession } = await import(path.join(ROOT, 'src/ledger.mjs'));
  const { saveEdits } = await import(path.join(ROOT, 'src/edits.mjs'));
  const fail = (msg) => { console.error(flags.json ? JSON.stringify({ error: msg }) : msg); process.exit(1); };
  let s, m;
  try {
    s = resolveSession(pos[0], cfg.outDir);
    if ('apply' in flags) {
      if (typeof flags.apply !== 'string' || !flags.apply) fail('--apply needs a file, or - for stdin');
      let edits;
      try { edits = JSON.parse(fs.readFileSync(flags.apply === '-' ? 0 : path.resolve(flags.apply), 'utf8')); } catch (e) { fail(`--apply: ${e instanceof SyntaxError ? `not JSON (${e.message})` : e.message}`); }
      saveEdits(s, edits);
    }
    m = mergedItems(s);
  } catch (e) { fail(e.message); }
  if (flags.json) { console.log(JSON.stringify(m, null, 2)); process.exit(0); }
  const all = m.chapters.flatMap((c) => c.items);
  console.log(`${path.basename(s)}: ${all.filter((i) => !i.deleted).length} item(s) (${all.filter((i) => i.edited).length} edited, ${all.filter((i) => i.origin === 'user').length} added, ${all.filter((i) => i.deleted).length} deleted)${'apply' in flags ? '; edits saved' : ''}`);
  for (const c of m.chapters) {
    console.log(`  Chapter ${c.n} "${c.name}"${c.brief ? '' : ': no brief yet'}`);
    for (const i of c.items) {
      const extra = [i.owner && `owner: ${i.owner}`, i.due && `due: ${i.due}`, i.priority && i.priority.slice(0, 40)].filter(Boolean).join(', ');
      console.log(`    ${(i.id || '-').padEnd(6)} ${i.key.padEnd(12)} ${String(i.type).padEnd(8)} ${(i.when || '').padEnd(6)} ${i.title}${extra ? `  [${extra}]` : ''}${i.edited ? '  (edited)' : ''}${i.deleted ? '  (deleted)' : ''}${i.refs.length ? `  -> ${i.refs.map((r) => r.ref).join(', ')}` : ''}`);
    }
  }
  for (const o of m.orphans) console.log(`  Orphaned edit ${o.key}: ${JSON.stringify(o.edit || o.added)} (its item is gone after a re-brief)`);
} else if (cmd === 'projects') {
  // Projects for the desktop and the CLI. 0 ok; 1 bad input (a JSON error on stderr with --json).
  const fail = (msg) => { console.error(flags.json ? JSON.stringify({ error: msg }) : msg); process.exit(1); };
  const [action, arg] = pos;
  if (!action) {
    const problems = [];
    const list = projects.listProjects(cfg, { onProblem: (p) => problems.push(p) });
    if (flags.json) console.log(JSON.stringify({ version: 1, dir: projects.projectsDir(cfg), default: cfg.project || null, projects: list, problems }, null, 2));
    else {
      if (!list.length) console.log(`no projects in ${projects.projectsDir(cfg)} (ux-walk projects save <file>)`);
      const { trackerLabel } = await import(path.join(ROOT, 'src/trackers/index.mjs'));
      for (const p of list) console.log(`${p.id === cfg.project ? '*' : ' '} ${p.id.padEnd(20)} ${p.name}${p.tracker ? `  -> ${trackerLabel(p.tracker)}` : ''}${p.glossary ? `  glossary: ${p.glossary}` : ''}`);
      for (const p of problems) console.error(`skipped ${p.file}: ${p.error}`);
    }
  } else if (action === 'show') {
    let p;
    try { p = projects.readProject(cfg, arg); } catch (e) { fail(e.message); }
    if (!p) fail(`no project "${arg || ''}" in ${projects.projectsDir(cfg)}`);
    console.log(JSON.stringify(p, null, 2));
  } else if (action === 'save') {
    if (!arg) fail('usage: ux-walk projects save <file|->');
    let j;
    try { j = JSON.parse(fs.readFileSync(arg === '-' ? 0 : path.resolve(arg), 'utf8')); } catch (e) { fail(e instanceof SyntaxError ? `not JSON (${e.message})` : e.message); }
    try { console.log(JSON.stringify(projects.saveProject(cfg, j), null, 2)); } catch (e) { fail(e.message); }
  } else fail('usage: ux-walk projects [--json] | projects show <id> | projects save <file|->');
} else if (cmd === 'trackers') {
  const { getTracker, trackerStatus } = await import(path.join(ROOT, 'src/trackers/index.mjs'));
  const fail = (msg) => { console.error(flags.json ? JSON.stringify({ error: msg }) : msg); process.exit(1); };
  const [action, id] = pos;
  if (!action) {
    const list = await trackerStatus(cfg);
    if (flags.json) console.log(JSON.stringify({ version: 1, trackers: list }, null, 2));
    else for (const t of list) console.log(`${t.id.padEnd(8)} ${t.name.padEnd(14)} ${t.ok ? `ready${t.via ? ` (${t.via})` : ''}` : `not ready: ${t.problem}`}`);
  } else if (action === 'targets') {
    let t, targets;
    try { t = getTracker(id); targets = await t.listTargets(cfg); } catch (e) { fail(e.message); }
    if (flags.json) console.log(JSON.stringify({ version: 1, tracker: t.id, targetKind: t.targetKind, targets }, null, 2));
    else { if (!targets.length) console.log(`no ${t.name} targets found`); for (const x of targets) console.log(`${x.id}${x.name !== x.id ? `  ${x.name}` : ''}`); }
  } else fail('usage: ux-walk trackers [--json] | trackers targets <id> [--json]');
} else if (cmd === 'file') {
  // Items become issues in the tracker; each is linked in ledger.json. 0 all filed (or nothing to do); 1 bad input
  // ({"error"} on stderr); 3 some items failed (the rest were filed; see "failed").
  const fail = (msg) => { console.error(JSON.stringify({ error: msg })); process.exit(1); };
  const { resolveSession } = await import(path.join(ROOT, 'src/ledger.mjs'));
  const { fileItems } = await import(path.join(ROOT, 'src/file.mjs'));
  if (!pos[0]) fail('usage: ux-walk file <folder> [--keys k1,k2 | --all] [--types action,bug] [--tracker id --target t] [--dry-run] [--json]');
  if (flags.keys && flags.all) fail('give --keys or --all, not both');
  for (const k of ['keys', 'types', 'tracker', 'target']) if (k in flags && (typeof flags[k] !== 'string' || !flags[k])) fail(`--${k} needs a value`);
  if (flags.types) { const { TYPES } = await import(path.join(ROOT, 'src/edits.mjs')); const bad = flags.types.split(',').map((x) => x.trim()).filter((x) => x && !TYPES.includes(x)); if (bad.length) fail(`--types: not a type: ${bad.join(', ')} (${TYPES.join(', ')})`); }
  let r;
  try {
    const s = resolveSession(pos[0], cfg.outDir);
    r = await fileItems(s, cfg, { keys: flags.keys, all: !!flags.all, types: flags.types, tracker: flags.tracker, target: flags.target, dryRun: !!flags['dry-run'] });
  } catch (e) { fail(e.message); }
  if (flags.json) console.log(JSON.stringify(r, null, 2));
  else {
    console.log(`${path.basename(r.session)} -> ${r.tracker} ${r.targetName}${r.dryRun ? ' (dry run: nothing filed)' : ''}`);
    for (const f of r.filed) console.log(`  ${r.dryRun ? 'would file' : 'filed'} ${f.key.padEnd(12)} ${String(f.type).padEnd(8)} ${f.title}${f.ref ? `  -> ${f.ref}${f.url ? ` ${f.url}` : ''}` : ''}`);
    for (const f of r.skipped) console.log(`  skipped ${f.key.padEnd(12)} already linked: ${f.refs.map((x) => x.ref).join(', ')}`);
    for (const f of r.failed) console.error(`  failed  ${f.key.padEnd(12)} ${f.error}`);
    if (!r.filed.length && !r.skipped.length && !r.failed.length) console.log('  nothing to file (ux-walk items lists the items; --types or --keys pick others)');
  }
  process.exit(r.failed.length ? 3 : 0);
} else if (cmd === 'handoff') {
  const { handoffAsk } = await import(path.join(ROOT, 'src/naming.mjs'));
  const { resolveSession } = await import(path.join(ROOT, 'src/ledger.mjs'));
  let h;
  try { h = handoffAsk(resolveSession(pos[0], cfg.outDir), cfg); } catch (e) { console.error(flags.json ? JSON.stringify({ error: e.message }) : e.message); process.exit(1); }
  console.log(flags.json ? JSON.stringify(h, null, 2) : `${h.line}\n\n${h.context}`);
} else if (cmd === 'status') {
  const { status, resolveSession, recentSessions } = await import(path.join(ROOT, 'src/ledger.mjs'));
  try {
    const list = flags.all ? recentSessions(cfg.outDir, 14) : [resolveSession(pos[0], cfg.outDir)];
    let open = 0, qs = 0;
    for (const s of list) {
      const r = status(s);
      if (flags.all && !r.open && !r.questions) continue;
      console.log(r.lines.join('\n') + '\n');
      open += r.open; qs += r.questions;
    }
    if (flags.all) console.log(`${list.length} recording(s) since ${new Date(Date.now() - 14 * 864e5).toISOString().slice(0, 10)}: ${open} item(s) with no ref, ${qs} open question(s)`);
  } catch (e) { console.error(e.message); process.exit(1); }
} else if (cmd === 'search') {
  const { search } = await import(path.join(ROOT, 'src/ledger.mjs'));
  if (!pos.length) { console.error('usage: ux-walk search <terms> [-n 40]'); process.exit(2); }
  const hits = search(cfg.outDir, pos, Number(flags.n) || 40);
  console.log(hits.length ? hits.join('\n') : 'no matches');
} else if (cmd === 'speakers') {
  const { confirmSpeakers } = await import(path.join(ROOT, 'src/speakers.mjs'));
  const { processChapter } = await import(path.join(ROOT, 'src/process.mjs'));
  const root = await dirArg(pos[0]);
  let names = String(flags.speakers || '').split(',').map((s) => s.trim()).filter(Boolean);
  if (!names.length && fs.existsSync(path.join(root, 'session.json'))) names = JSON.parse(fs.readFileSync(path.join(root, 'session.json'), 'utf8')).speakers || [];
  const { createAsker } = await import(path.join(ROOT, 'src/ask.mjs'));
  const asker = createAsker();
  const changed = await confirmSpeakers(asker, chapterDirs(root), names.length ? names : [cfg.me], { always: true });
  asker.close();
  for (const d of changed) await processChapter(d, { ...cfg, transcriber: 'none', sections: 'cached' }, { quiet: true, log: () => {}, brief: cfg.brief && fs.existsSync(path.join(d, 'brief.md')) });
  console.log(changed.length ? `updated ${changed.length} chapter(s)` : 'no changes');
} else if (cmd === 'frame') {
  // For an agent reading a timeline: the screen at any moment, not only where a shot was taken.
  const d = await dirArg(pos.shift());
  if (!pos.length) { console.error('give one or more times: ux-walk frame <chapter> 18:07 [19:26 ...]'); process.exit(2); }
  fs.mkdirSync(path.join(d, 'shots'), { recursive: true });
  for (const at of pos) {
    const [m, s] = at.split(':').map(Number);
    if (!Number.isFinite(m) || !Number.isFinite(s)) { console.error(`not a time: ${at} (use mm:ss)`); process.exit(2); }
    const t = m * 60 + s;
    const out = path.join(d, 'shots', `frame-${String(m).padStart(2, '0')}m${s.toFixed(1).padStart(4, '0')}s.jpg`);
    const r = spawnSync('ffmpeg', ['-v', 'error', '-y', '-ss', String(t), '-i', path.join(d, 'video.mp4'), '-frames:v', '1', '-vf', 'scale=min(1280\\,iw):-2', '-q:v', '4', out], { encoding: 'utf8' });
    console.log(r.status === 0 ? out : `failed at ${at}: ${r.stderr.trim()}`);
  }
} else if (cmd === 'glossary') {
  const { listGlossaries, glossaryPath, GLOSSARY_DIR, DEFAULT_GLOSSARY } = await import(path.join(ROOT, 'src/glossary.mjs'));
  if (['suggestions', 'accept', 'reject'].includes(pos[0])) {
    // Glossary suggestions from a recording: list them, or accept (writes the glossary) or reject some.
    const G = await import(path.join(ROOT, 'src/glossary-suggestions.mjs'));
    const { resolveSession } = await import(path.join(ROOT, 'src/ledger.mjs'));
    const fail = (msg) => { console.error(flags.json ? JSON.stringify({ error: msg }) : msg); process.exit(1); };
    const [sub, folder, ...terms] = pos;
    let s;
    try { s = resolveSession(folder, cfg.outDir); } catch (e) { fail(e.message); }
    const show = (list) => list.map((x) => `  ${x.status.padEnd(8)} ${x.term}${x.wrongs.length ? `: ${x.wrongs.join(', ')}` : ''}  (${x.source}${x.evidence?.when ? `, ch${x.evidence.chapter} ${x.evidence.when}` : x.evidence?.chapter ? `, ch${x.evidence.chapter}` : ''})`).join('\n');
    try {
      if (sub === 'suggestions') {
        const r = { session: s, file: path.join(s, G.SUGGESTIONS_FILE), target: G.acceptTarget(s, cfg), suggestions: G.readSuggestions(s).suggestions };
        if (flags.json) console.log(JSON.stringify(r, null, 2));
        else console.log(r.suggestions.length ? `${show(r.suggestions)}\naccept goes to ${r.target}` : 'no glossary suggestions');
      } else if (sub === 'accept') {
        if (!flags.all && !terms.length) fail('usage: ux-walk glossary accept <session> <term...|--all> [--to <glossary>] [--json]');
        const r = { session: s, ...G.acceptSuggestions(s, flags.all ? 'all' : terms, { cfg, to: typeof flags.to === 'string' ? flags.to : null }) };
        if (flags.json) console.log(JSON.stringify(r, null, 2));
        else console.log(r.accepted.length ? `added to ${r.target}: ${r.accepted.join(', ')}` : 'nothing pending to accept');
      } else {
        if (!terms.length) fail('usage: ux-walk glossary reject <session> <term...> [--json]');
        const r = { session: s, ...G.rejectSuggestions(s, terms) };
        if (flags.json) console.log(JSON.stringify(r, null, 2));
        else console.log(`rejected: ${r.rejected.join(', ')}`);
      }
    } catch (e) { fail(e.message); }
  } else if (pos[0] === 'new' && pos[1]) {
    const f = glossaryPath(pos[1]);
    fs.mkdirSync(path.dirname(f), { recursive: true });
    if (!fs.existsSync(f)) fs.writeFileSync(f, '# Names the transcript gets wrong. One per line: Right spelling: wrong one, wrong two\n');
    console.log(f);
  } else {
    const g = listGlossaries();
    console.log(`always used: ${g.default || `${DEFAULT_GLOSSARY} (not created yet)`}`);
    console.log(`named (${GLOSSARY_DIR}): ${g.named.join(', ') || 'none'}`);
    console.log('add per recording: ux-walk <topic> --glossary <name>[,<name>]');
  }
} else if (cmd === 'windows') {
  const r = spawnSync(path.join(ROOT, 'bin', 'uxw-capture'), ['--list'], { encoding: 'utf8' });
  for (const l of r.stdout.split('\n').filter(Boolean)) {
    const w = JSON.parse(l);
    console.log(w.ev === 'error' ? w.message : `${String(w.windowId).padStart(6)}  ${w.app.padEnd(18)} ${w.w}x${w.h}  ${w.title}`);
  }
} else if (cmd === 'app') {
  const app = path.join(process.env.UXW_APP_DIR || path.join(process.env.HOME, 'Applications'), 'ux-walk.app');
  if (!fs.existsSync(app)) { console.error(`no ${app}; run ${path.join(ROOT, 'install.sh')}`); process.exit(1); }
  spawnSync('open', [app], { stdio: 'inherit' });
} else if (cmd === 'setup') {
  fs.mkdirSync(CONFIG_DIR, { recursive: true });
  if (!fs.existsSync(CONFIG_FILE)) {
    fs.writeFileSync(CONFIG_FILE, JSON.stringify({ url: cfg.url, outDir: '~/Movies/ux-walk', speakers: '' }, null, 2) + '\n');
    console.log(`wrote ${CONFIG_FILE}`);
  }
  // The always-used glossary (config "glossary" names extra ones; it is often empty).
  const gl = (await import(path.join(ROOT, 'src/glossary.mjs'))).DEFAULT_GLOSSARY;
  if (!fs.existsSync(gl)) { fs.copyFileSync(path.join(ROOT, 'glossary.example.txt'), gl); console.log(`wrote ${gl} (names the transcript gets wrong)`); }
  // Transcriber and its key (the menu bar app's Settings do the same).
  const { PROVIDERS } = await import(path.join(ROOT, 'src/transcribe.mjs'));
  const rl = readline.createInterface({ input: process.stdin, output: process.stdout });
  const ids = [...Object.keys(PROVIDERS), 'none'];
  const pick = (await rl.question(`Transcriber (${ids.join(', ')}) [${cfg.transcriber}]: `)).trim().toLowerCase() || cfg.transcriber;
  if (!ids.includes(pick)) { console.error(`not a transcriber: ${pick}`); process.exit(2); }
  const saved = JSON.parse(fs.readFileSync(CONFIG_FILE, 'utf8'));
  if (saved.transcriber !== pick) { saved.transcriber = pick; fs.writeFileSync(CONFIG_FILE, JSON.stringify(saved, null, 2) + '\n'); }
  if (pick !== 'none') {
    const p = PROVIDERS[pick], item = p.item(cfg);
    let has = false;
    try { execFileSync('security', ['find-generic-password', '-a', process.env.USER, '-s', item], { stdio: 'ignore' }); has = true; } catch {}
    const ans = await rl.question(has ? `${p.name} key is set. Replace it? [y/N] ` : `Paste your ${p.name} API key (${p.keyUrl}; empty to skip): `);
    const token = has ? (/^y/i.test(ans) ? await rl.question('New key: ') : '') : ans;
    if (token.trim()) {
      execFileSync('security', ['add-generic-password', '-U', '-a', process.env.USER, '-s', item, '-w', token.trim()]);
      console.log(`saved to Keychain item "${item}"`);
    }
  }
  // Issue tracker for `ux-walk file` (optional): its key goes to the Keychain like the transcriber's.
  const { TRACKERS, trackerKeyPresent, storeTrackerKey, trackerStatus } = await import(path.join(ROOT, 'src/trackers/index.mjs'));
  const tids = [...Object.keys(TRACKERS), 'none'];
  const tpick = (await rl.question(`Issue tracker for filing items (${tids.join(', ')}) [none]: `)).trim().toLowerCase() || 'none';
  if (!tids.includes(tpick)) { console.error(`not a tracker: ${tpick}`); process.exit(2); }
  if (tpick !== 'none') {
    const t = TRACKERS[tpick];
    const ready = (await trackerStatus(cfg)).find((x) => x.id === tpick);
    if (t.keychainItem(cfg) && !(t.id === 'github' && ready.via === 'gh')) {
      const has = trackerKeyPresent(cfg, tpick);
      const ans = await rl.question(has ? `${t.name} key is set. Replace it? [y/N] ` : `Paste your ${t.name} key (${t.keyUrl}; empty to skip): `);
      const token = has ? (/^y/i.test(ans) ? await rl.question('New key: ') : '') : ans;
      if (token.trim()) console.log(`saved to Keychain item "${storeTrackerKey(cfg, tpick, token.trim())}"`);
    }
    const now = (await trackerStatus(cfg)).find((x) => x.id === tpick);
    console.log(now.ok ? `${t.name}: ready${now.via ? ` (${now.via})` : ''}.` : `${t.name}: not ready: ${now.problem}`);
    console.log(`Pick where items go: ux-walk trackers targets ${tpick}; then put it in a project (ux-walk projects save <file>).`);
  }
  rl.close();
  const r = spawnSync(path.join(ROOT, 'bin', 'uxw-capture'), ['--list'], { encoding: 'utf8' });
  console.log(r.status === 0 && r.stdout.trim()
    ? 'Screen Recording: allowed.'
    : 'Screen Recording: not allowed yet. System Settings > Privacy & Security > Screen & System Audio Recording: turn on your terminal app, then restart it.');
  console.log('Microphone: macOS asks the first time you record; allow it for your terminal app.');
}
