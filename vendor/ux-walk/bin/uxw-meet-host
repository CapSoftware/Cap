#!/usr/bin/env node
// Preserve the installed native host identity; Meet and selected-tab capture share this bridge.
import os from 'node:os';
import path from 'node:path';
import fs from 'node:fs';
import { createNativeBridge } from '../src/native-bridge.mjs';
import { COMPANION_EXTENSION } from '../src/companion.mjs';
const bridge = createNativeBridge({ configDir: process.env.CAP_UX_WALK_CONFIG_DIR || path.join(os.homedir(), '.config', 'ux-walk') });
const allowed = process.argv[2] === `chrome-extension://${COMPANION_EXTENSION}/`;
function reply(value) {
  if (!value) return;
  const body = Buffer.from(JSON.stringify(value)), head = Buffer.alloc(4);
  head.writeUInt32LE(body.length); fs.writeSync(1, Buffer.concat([head, body]));
}
let buf = Buffer.alloc(0);
let requests = Promise.resolve();
let queued = 0;
process.stdin.on('data', (data) => {
  buf = Buffer.concat([buf, data]);
  while (buf.length >= 4) {
    const size = buf.readUInt32LE(0);
    if (size > 512 * 1024) { process.stderr.write('ux-walk: native message exceeds 512 KiB\n'); process.exit(1); }
    if (buf.length < 4 + size) break;
    const body = buf.subarray(4, 4 + size); buf = buf.subarray(4 + size);
    if (queued >= 64) { reply({ ok: false, error: 'Native companion queue is full.' }); continue; }
    queued++;
    requests = requests.then(async () => {
      let message;
      try { message = JSON.parse(body.toString('utf8')); if (!allowed && message.type !== 'hello') throw new Error('Native host caller origin is not allowed.'); reply(await bridge.handle(message)); }
      catch (error) { reply({ requestId: message?.requestId, ok: false, error: error.message }); }
      finally { queued--; }
    });
  }
});
process.stdin.on('end', () => { requests.finally(() => process.exit(0)); });
