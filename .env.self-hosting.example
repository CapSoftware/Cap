# Copy to .env next to docker-compose.yml and fill in every value.
# Generate each secret with: openssl rand -hex 32
# cap-web and the media server refuse to start when these are missing or left at a known placeholder.
NEXTAUTH_SECRET=
DATABASE_ENCRYPTION_KEY=
MEDIA_SERVER_WEBHOOK_SECRET=

# Optional: database and storage passwords (internal-only defaults are used when unset)
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MINIO_ROOT_USER=cap-admin
MINIO_ROOT_PASSWORD=

# Public URLs
CAP_URL=http://localhost:3000
S3_PUBLIC_URL=http://localhost:9000

# Optional: email. Without both values, login codes are printed to the cap-web logs.
RESEND_API_KEY=
RESEND_FROM_DOMAIN=
